WAREHOUSE_ENVIRONMENT=development
WAREHOUSE_PUBLIC_ORIGIN=http://localhost:8080
WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse_os:local-only-change-me@127.0.0.1:5432/warehouse_os
WAREHOUSE_MIGRATION_DATABASE_URL=postgresql+psycopg://warehouse_migrator:local-only-migration-change-me@127.0.0.1:5432/warehouse_os
WAREHOUSE_JWT_SECRET=replace-with-a-unique-32-character-or-longer-secret
WAREHOUSE_ASSET_STORAGE_ROOT=var/digital-assets
WAREHOUSE_ASSET_CODE_SSD_ROOT=var/digital-assets-code-ssd
WAREHOUSE_HOSTED_RUNTIME_DATA_ROOT=var/hosted-runtime-data
WAREHOUSE_HOSTED_DATABASE_ROOT=var/hosted-databases
# Production only; injected by the deployment manager and never exposed to clients.
WAREHOUSE_HOSTED_DATABASE_ADMIN_URL=
WAREHOUSE_HOSTED_DATABASE_POOL_SIZE=2
WAREHOUSE_HOSTED_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Optional read-only source during migration from an older local volume:
# WAREHOUSE_ASSET_LEGACY_STORAGE_ROOT=/data/legacy-assets
WAREHOUSE_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://app.bonfirework.org
WAREHOUSE_SHIELD_AGENT_SOCKET=/run/warehouse-shield/agent.sock
WAREHOUSE_SHIELD_AGENT_TOKEN=replace-with-a-unique-32-character-or-longer-token
WAREHOUSE_SHIELD_REPAIR_APPLY=false
WAREHOUSE_SHIELD_DATA_MOUNTPOINT=/mnt/warehouse-data
WAREHOUSE_SHIELD_DATA_DEVICE=/dev/vdb1
WAREHOUSE_SHIELD_DATA_VOLUME_REQUIRED=false
WAREHOUSE_BROWSER_RUNTIME_ENABLED=false
WAREHOUSE_BROWSER_WORKER_TOKEN=replace-with-a-unique-32-character-or-longer-token
WAREHOUSE_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
WAREHOUSE_BROWSER_RESOURCE_ORIGINS=https://static.cloudflareinsights.com,https://cloudflareinsights.com,https://fonts.googleapis.com,https://fonts.gstatic.com,https://unpkg.com
