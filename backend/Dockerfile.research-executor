FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /service
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
RUN pip install . "numpy>=2,<3" "pandas>=2,<3" "scipy>=1.15,<2"

CMD ["python", "-m", "app.research_executor"]
