#!/usr/bin/env bash
set -Eeuo pipefail

# Compatibility entry point for older automation. All behavior lives in the
# canonical manager so deployment and migration authority cannot drift.
CANONICAL_MANAGER="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/macos/warehouse-deploy-macos"
[[ -x "${CANONICAL_MANAGER}" ]] || {
  printf 'canonical macOS deployment manager is unavailable\n' >&2
  exit 2
}
exec "${CANONICAL_MANAGER}" "$@"
