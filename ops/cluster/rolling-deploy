#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MODE="${1:-smart}"
ACTIVATION_SLO_SECONDS="${WAREHOUSE_CLUSTER_ACTIVATION_SLO_SECONDS:-60}"
PREFLIGHT="${WAREHOUSE_CLUSTER_PREFLIGHT:-full}"
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/warehouse-cluster-deploy.XXXXXX")"

fail() {
  printf 'cluster deploy error: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  rm -rf "${WORK_DIR}"
}
trap cleanup EXIT

[[ "${MODE}" =~ ^(smart|quick|standard|full)$ ]] \
  || fail "mode must be smart, quick, standard or full"
[[ "${ACTIVATION_SLO_SECONDS}" =~ ^[1-9][0-9]?$ ]] \
  || fail "activation SLO must be between 1 and 99 seconds"
[[ -z "$(git -C "${ROOT}" status --porcelain=v1)" ]] \
  || fail "controller checkout must be clean"

node_value() {
  local prefix="$1" name="$2" fallback="$3" variable
  variable="${prefix}_${name}"
  printf '%s\n' "${!variable:-${fallback}}"
}

run_node() {
  local prefix="$1" label="$2" action="$3" release_file="${4:-}"
  local plan_file="${5:-}"
  local action_command action_argument
  local host user identity manager incoming target manager_sudo prepare_incoming scp_legacy
  local known_hosts transport migration_defer
  if [[ "${prefix}" == WAREHOUSE_PRIMARY ]]; then
    host="$(node_value "${prefix}" HOST 100.69.250.61)"
    user="$(node_value "${prefix}" USER peiyuan)"
    identity="$(node_value "${prefix}" IDENTITY "${HOME}/.ssh/id_ed25519")"
    manager="$(node_value "${prefix}" REMOTE_MANAGER /Users/peiyuan/Server/bonfirework/bin/warehouse-deploy)"
    incoming="$(node_value "${prefix}" INCOMING /Users/peiyuan/Server/bonfirework/incoming)"
    manager_sudo="$(node_value "${prefix}" MANAGER_SUDO 0)"
    prepare_incoming="$(node_value "${prefix}" PREPARE_INCOMING 0)"
    scp_legacy="$(node_value "${prefix}" SCP_LEGACY 1)"
    migration_defer="$(node_value "${prefix}" DATABASE_MIGRATION_DEFER 1)"
  else
    host="$(node_value "${prefix}" HOST 207.148.120.30)"
    user="$(node_value "${prefix}" USER warehouse-deploy)"
    identity="$(node_value "${prefix}" IDENTITY "${HOME}/.ssh/warehouse_os_deploy_ed25519")"
    manager="$(node_value "${prefix}" REMOTE_MANAGER /usr/local/sbin/warehouse-deploy)"
    incoming="$(node_value "${prefix}" INCOMING /var/lib/warehouse-deploy/incoming)"
    manager_sudo="$(node_value "${prefix}" MANAGER_SUDO 1)"
    prepare_incoming="$(node_value "${prefix}" PREPARE_INCOMING 1)"
    scp_legacy="$(node_value "${prefix}" SCP_LEGACY 0)"
    migration_defer="$(node_value "${prefix}" DATABASE_MIGRATION_DEFER 1)"
  fi
  target="$(node_value "${prefix}" TARGET "${label}")"
  known_hosts="$(node_value "${prefix}" KNOWN_HOSTS "${HOME}/.ssh/known_hosts")"
  transport="$(node_value "${prefix}" TRANSPORT ssh)"
  if [[ "${transport}" == ssh ]]; then
    [[ -f "${identity}" ]] || fail "identity is missing for ${label}: ${identity}"
  fi
  read -r action_command action_argument <<<"${action}"
  [[ "${action_command}" =~ ^(prepare|prepared-status|migration-start|migration-status|migration-wait|migration-reconcile|activate|status|rollback)$ ]] \
    || fail "unsupported node action: ${action_command}"
  if [[ "${action_command}" =~ ^(status|rollback)$ ]]; then
    [[ -z "${action_argument:-}" ]] || fail "${action_command} takes no argument"
  else
    [[ -n "${action_argument:-}" ]] || fail "${action_command} requires an argument"
  fi

  local deploy_command=("${ROOT}/ops/deploy" "${action_command}")
  [[ -z "${action_argument:-}" ]] || deploy_command+=("${action_argument}")
  env \
    WAREHOUSE_DEPLOY_HOST="${host}" \
    WAREHOUSE_DEPLOY_USER="${user}" \
    WAREHOUSE_DEPLOY_IDENTITY="${identity}" \
    WAREHOUSE_DEPLOY_KNOWN_HOSTS="${known_hosts}" \
    WAREHOUSE_DEPLOY_TARGET="${target}" \
    WAREHOUSE_DEPLOY_TRANSPORT="${transport}" \
    WAREHOUSE_REMOTE_DEPLOY_MANAGER="${manager}" \
    WAREHOUSE_DEPLOY_INCOMING="${incoming}" \
    WAREHOUSE_DEPLOY_MANAGER_SUDO="${manager_sudo}" \
    WAREHOUSE_DEPLOY_PREPARE_INCOMING="${prepare_incoming}" \
    WAREHOUSE_DEPLOY_SCP_LEGACY="${scp_legacy}" \
    WAREHOUSE_DATABASE_MIGRATION_DEFER="${migration_defer}" \
    WAREHOUSE_DEPLOY_LOCAL_VALIDATION=basic \
    WAREHOUSE_DEPLOY_RELEASE_ID_FILE="${release_file}" \
    WAREHOUSE_DEPLOY_PLAN_FILE="${plan_file}" \
    "${deploy_command[@]}"
}

upload_node_secret() {
  local prefix="$1" label="$2" source_file="$3" remote_name="$4"
  local host user identity incoming known_hosts transport scp_legacy
  local scp_options
  [[ -f "${source_file}" ]] || fail "secret handoff file is missing for ${label}"
  [[ "${remote_name}" =~ ^control-replication-[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]{1,80}\.env$ ]] \
    || fail "secret handoff name is invalid for ${label}"
  host="$(node_value "${prefix}" HOST 207.148.120.30)"
  user="$(node_value "${prefix}" USER warehouse-deploy)"
  identity="$(node_value "${prefix}" IDENTITY "${HOME}/.ssh/warehouse_os_deploy_ed25519")"
  incoming="$(node_value "${prefix}" INCOMING /var/lib/warehouse-deploy/incoming)"
  known_hosts="$(node_value "${prefix}" KNOWN_HOSTS "${HOME}/.ssh/known_hosts")"
  transport="$(node_value "${prefix}" TRANSPORT ssh)"
  scp_legacy="$(node_value "${prefix}" SCP_LEGACY 0)"
  [[ "${incoming}" == /* && "${incoming}" != *[[:space:]]* \
      && "${incoming}" != *../* && "${incoming}" != */.. ]] \
    || fail "incoming path is unsafe for ${label}"
  if [[ "${transport}" == local ]]; then
    install -m 0600 "${source_file}" "${incoming}/${remote_name}"
    return 0
  fi
  [[ -n "${host}" && "${host}" != *[[:space:]]* ]] \
    || fail "host is invalid for ${label}"
  [[ "${user}" =~ ^[A-Za-z_][A-Za-z0-9._-]{0,63}$ ]] \
    || fail "user is invalid for ${label}"
  [[ -f "${identity}" ]] || fail "identity is missing for ${label}: ${identity}"
  [[ -f "${known_hosts}" ]] || fail "known hosts are missing for ${label}: ${known_hosts}"
  scp_options=(
    -F /dev/null
    -i "${identity}"
    -o BatchMode=yes
    -o IdentitiesOnly=yes
    -o StrictHostKeyChecking=yes
    -o UserKnownHostsFile="${known_hosts}"
    -o ConnectTimeout=15
  )
  [[ "${scp_legacy}" == 1 ]] && scp_options+=(-O)
  scp -p "${scp_options[@]}" "${source_file}" \
    "${user}@${host}:${incoming}/${remote_name}"
}

wait_phase() {
  local primary_pid="$1" standby_pid="$2"
  PRIMARY_STATUS=0
  STANDBY_STATUS=0
  if [[ -n "${primary_pid}" ]]; then
    if wait "${primary_pid}"; then PRIMARY_STATUS=0; else PRIMARY_STATUS=$?; fi
  fi
  if [[ -n "${standby_pid}" ]]; then
    if wait "${standby_pid}"; then STANDBY_STATUS=0; else STANDBY_STATUS=$?; fi
  fi
}

plan_value() {
  local plan_file="$1" key="$2" label="$3" count value
  [[ -s "${plan_file}" ]] || fail "${label} prepare plan is missing"
  count="$(awk -F= -v key="${key}" '$1 == key {count++} END {print count+0}' "${plan_file}")"
  [[ "${count}" == 1 ]] || fail "${label} prepare plan must contain one ${key}"
  value="$(awk -F= -v key="${key}" '$1 == key {print $2; exit}' "${plan_file}")"
  printf '%s\n' "${value}"
}

run_preflight() {
  printf '==> controller preflight policy=%s\n' "${PREFLIGHT}"
  git -C "${ROOT}" diff --check
  node "${ROOT}/scripts/build_v2_frontend.cjs" --check
  bash -n \
    "${ROOT}/ops/deploy" \
    "${ROOT}/ops/cluster/configure-control-publication-macos" \
    "${ROOT}/ops/cluster/rolling-deploy" \
    "${ROOT}/ops/cluster/set-vultr-reverse-subscriptions" \
    "${ROOT}/ops/macos/warehouse-deploy-macos" \
    "${ROOT}/ops/macos/warehouse-deploy-ssh-gate" \
    "${ROOT}/ops/server/warehouse-deploy"
  case "${PREFLIGHT}" in
    full)
      "${ROOT}/ops/run-full-verification"
      ;;
    basic)
      PYTHONPYCACHEPREFIX="${WORK_DIR}/python-cache" \
        python3 -m compileall -q "${ROOT}/backend/app" "${ROOT}/backend/alembic/versions"
      ;;
    *)
      fail "WAREHOUSE_CLUSTER_PREFLIGHT must be full or basic"
      ;;
  esac
}

run_preflight

primary_release_file="${WORK_DIR}/primary.release"
standby_release_file="${WORK_DIR}/standby.release"
primary_plan_file="${WORK_DIR}/primary.plan"
standby_plan_file="${WORK_DIR}/standby.plan"
printf '==> parallel prepare: mac-primary + vultr-standby\n'
run_node WAREHOUSE_PRIMARY mac-primary "prepare ${MODE}" \
  "${primary_release_file}" "${primary_plan_file}" \
  >"${WORK_DIR}/primary.prepare.log" 2>&1 &
primary_pid=$!
run_node WAREHOUSE_STANDBY vultr-standby "prepare ${MODE}" \
  "${standby_release_file}" "${standby_plan_file}" \
  >"${WORK_DIR}/standby.prepare.log" 2>&1 &
standby_pid=$!
wait_phase "${primary_pid}" "${standby_pid}"
primary_status="${PRIMARY_STATUS}"
standby_status="${STANDBY_STATUS}"
cat "${WORK_DIR}/primary.prepare.log"
cat "${WORK_DIR}/standby.prepare.log"
[[ "${primary_status}" == 0 && "${standby_status}" == 0 ]] \
  || fail "parallel prepare failed (primary=${primary_status}, standby=${standby_status})"

primary_deploy="$(plan_value "${primary_plan_file}" deploy_required primary)"
standby_deploy="$(plan_value "${standby_plan_file}" deploy_required standby)"
primary_migration="$(plan_value "${primary_plan_file}" migration_required primary)"
standby_migration="$(plan_value "${standby_plan_file}" migration_required standby)"
[[ "${primary_deploy}" =~ ^[01]$ && "${standby_deploy}" =~ ^[01]$ ]] \
  || fail "prepared deployment impact is invalid"
[[ "${primary_migration}" =~ ^[01]$ && "${standby_migration}" =~ ^[01]$ ]] \
  || fail "prepared migration impact is invalid"
[[ "${primary_deploy}" == 1 || "${primary_migration}" == 0 ]] \
  || fail "primary no-op cannot require a database migration"
[[ "${standby_deploy}" == 1 || "${standby_migration}" == 0 ]] \
  || fail "standby no-op cannot require a database migration"

primary_release=""
if [[ "${primary_deploy}" == 1 ]]; then
  [[ -s "${primary_release_file}" ]] || fail "primary prepared release id is missing"
  primary_release="$(tr -d '\r\n' < "${primary_release_file}")"
  [[ "${primary_release}" =~ ^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]{1,80}$ ]] \
    || fail "primary prepared release id is invalid"
elif [[ -s "${primary_release_file}" ]]; then
  fail "primary no-op unexpectedly emitted a release id"
fi

standby_release=""
if [[ "${standby_deploy}" == 1 ]]; then
  [[ -s "${standby_release_file}" ]] || fail "standby prepared release id is missing"
  standby_release="$(tr -d '\r\n' < "${standby_release_file}")"
  [[ "${standby_release}" =~ ^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]{1,80}$ ]] \
    || fail "standby prepared release id is invalid"
elif [[ -s "${standby_release_file}" ]]; then
  fail "standby no-op unexpectedly emitted a release id"
fi

printf '==> prepare decisions primary_deploy=%s standby_deploy=%s\n' \
  "${primary_deploy}" "${standby_deploy}"
migration_required=0
if [[ "${primary_migration}" == 1 || "${standby_migration}" == 1 ]]; then
  migration_required=1
fi
if [[ "${migration_required}" == 1 && "${primary_deploy}" != "${standby_deploy}" ]]; then
  fail "asymmetric database migration requires explicit recovery"
fi

if [[ "${migration_required}" == 1 ]]; then
  printf '==> background database gate: standby schema, then primary data\n'
  # Both prepares only build and validate code. The database phase is explicit:
  # bootstrap the fenced subscriber if needed, apply standby schema first, then
  # primary backup/schema/data, and finally reconcile replication.
  : "${WAREHOUSE_CONTROL_REPL_PASSWORD:?control replication password is required for a schema release}"
  [[ "${WAREHOUSE_CONTROL_REPL_PASSWORD}" =~ ^[0-9a-f]{64}$ ]] \
    || fail "control replication password is malformed"
  WAREHOUSE_CONTROL_REPL_PASSWORD="${WAREHOUSE_CONTROL_REPL_PASSWORD}" \
    "${ROOT}/ops/cluster/configure-control-publication-macos"
  control_secret_file="${WORK_DIR}/control-replication-${standby_release}.env"
  (
    umask 077
    printf 'WAREHOUSE_CONTROL_REPL_PASSWORD=%s\n' \
      "${WAREHOUSE_CONTROL_REPL_PASSWORD}" > "${control_secret_file}"
  )
  upload_node_secret WAREHOUSE_STANDBY vultr-standby \
    "${control_secret_file}" "$(basename "${control_secret_file}")"
  run_node WAREHOUSE_STANDBY vultr-standby "migration-start ${standby_release}" ""
  run_node WAREHOUSE_STANDBY vultr-standby "migration-wait ${standby_release}" ""
  run_node WAREHOUSE_STANDBY vultr-standby "migration-status ${standby_release}" ""
  run_node WAREHOUSE_PRIMARY mac-primary "migration-start ${primary_release}" ""
  run_node WAREHOUSE_PRIMARY mac-primary "migration-wait ${primary_release}" ""
  run_node WAREHOUSE_PRIMARY mac-primary "migration-status ${primary_release}" ""
  run_node WAREHOUSE_STANDBY vultr-standby "migration-reconcile ${standby_release}" ""
else
  printf '==> database phase skipped (code-only release)\n'
fi

printf '==> prepared gate\n'
primary_pid=""
standby_pid=""
if [[ "${primary_deploy}" == 1 ]]; then
  run_node WAREHOUSE_PRIMARY mac-primary "prepared-status ${primary_release}" "" \
    >"${WORK_DIR}/primary.gate.log" 2>&1 &
  primary_pid=$!
else
  printf 'node=mac-primary action=prepared-status status=skipped reason=already_current\n' \
    >"${WORK_DIR}/primary.gate.log"
fi
if [[ "${standby_deploy}" == 1 ]]; then
  run_node WAREHOUSE_STANDBY vultr-standby "prepared-status ${standby_release}" "" \
    >"${WORK_DIR}/standby.gate.log" 2>&1 &
  standby_pid=$!
else
  printf 'node=vultr-standby action=prepared-status status=skipped reason=already_current\n' \
    >"${WORK_DIR}/standby.gate.log"
fi
wait_phase "${primary_pid}" "${standby_pid}"
primary_status="${PRIMARY_STATUS}"
standby_status="${STANDBY_STATUS}"
cat "${WORK_DIR}/primary.gate.log"
cat "${WORK_DIR}/standby.gate.log"
[[ "${primary_status}" == 0 && "${standby_status}" == 0 ]] \
  || fail "prepared gate failed (primary=${primary_status}, standby=${standby_status})"

printf '==> coordinated activation (SLO=%ss)\n' "${ACTIVATION_SLO_SECONDS}"
activation_started="${SECONDS}"
primary_pid=""
standby_pid=""
if [[ "${primary_deploy}" == 1 ]]; then
  run_node WAREHOUSE_PRIMARY mac-primary "activate ${primary_release}" "" \
    >"${WORK_DIR}/primary.activate.log" 2>&1 &
  primary_pid=$!
else
  printf 'node=mac-primary action=activate status=skipped reason=already_current\n' \
    >"${WORK_DIR}/primary.activate.log"
fi
if [[ "${standby_deploy}" == 1 ]]; then
  run_node WAREHOUSE_STANDBY vultr-standby "activate ${standby_release}" "" \
    >"${WORK_DIR}/standby.activate.log" 2>&1 &
  standby_pid=$!
else
  printf 'node=vultr-standby action=activate status=skipped reason=already_current\n' \
    >"${WORK_DIR}/standby.activate.log"
fi
wait_phase "${primary_pid}" "${standby_pid}"
primary_status="${PRIMARY_STATUS}"
standby_status="${STANDBY_STATUS}"
activation_duration="$((SECONDS - activation_started))"
cat "${WORK_DIR}/primary.activate.log"
cat "${WORK_DIR}/standby.activate.log"

if [[ "${primary_status}" != 0 || "${standby_status}" != 0 ]]; then
  printf '==> coordinated rollback after partial activation failure\n' >&2
  if [[ "${primary_deploy}" == 1 && "${primary_status}" == 0 ]]; then
    run_node WAREHOUSE_PRIMARY mac-primary rollback "" || true
  fi
  if [[ "${standby_deploy}" == 1 && "${standby_status}" == 0 ]]; then
    run_node WAREHOUSE_STANDBY vultr-standby rollback "" || true
  fi
  fail "activation failed (primary=${primary_status}, standby=${standby_status})"
fi

printf '==> post-activation identity gate\n'
run_node WAREHOUSE_PRIMARY mac-primary status "" >"${WORK_DIR}/primary.status"
run_node WAREHOUSE_STANDBY vultr-standby status "" >"${WORK_DIR}/standby.status"
cat "${WORK_DIR}/primary.status"
cat "${WORK_DIR}/standby.status"
git_sha="$(git -C "${ROOT}" rev-parse --short=12 HEAD)"
full_git_sha="$(git -C "${ROOT}" rev-parse HEAD)"
grep -Fq "\"node_id\":\"mac-primary\"" "${WORK_DIR}/primary.status" \
  || fail "primary identity gate failed"
grep -Fq "\"node_id\":\"vultr-standby\"" "${WORK_DIR}/standby.status" \
  || fail "standby identity gate failed"
grep -Eq "\"git_sha\":\"(${git_sha}|${full_git_sha})\"" "${WORK_DIR}/primary.status" \
  || fail "primary Git baseline does not match ${git_sha}"
grep -Eq "\"git_sha\":\"(${git_sha}|${full_git_sha})\"" "${WORK_DIR}/standby.status" \
  || fail "standby Git baseline does not match ${git_sha}"

(( activation_duration <= ACTIVATION_SLO_SECONDS )) \
  || fail "activation SLO breached: ${activation_duration}s > ${ACTIVATION_SLO_SECONDS}s"
printf '==> cluster deployment complete git_sha=%s activation_seconds=%s\n' \
  "${git_sha}" "${activation_duration}"
