#!/usr/bin/env bash
set -Eeuo pipefail

mode="${1:-verify}"
[[ "$(uname -s)" == Linux ]] || {
  printf 'this reverse subscription manager is only for the Vultr Linux node\n' >&2
  exit 2
}
[[ "${mode}" == prepare || "${mode}" == enable || "${mode}" == disable || "${mode}" == verify ]] || {
  printf 'usage: %s prepare|enable|disable|verify\n' "$0" >&2
  exit 2
}

control_container="${CONTROL_POSTGRES_CONTAINER:-warehouse-os-postgres-1}"
hosted_container="${HOSTED_POSTGRES_CONTAINER:-warehouse-os-hosted-postgres}"
publisher_host="${WAREHOUSE_MAC_PUBLISHER_HOST:-100.69.250.61}"
control_port="${WAREHOUSE_MAC_CONTROL_PUBLISHER_PORT:-15432}"
hosted_port="${WAREHOUSE_MAC_HOSTED_PUBLISHER_PORT:-5433}"
control_subscription=warehouse_from_mac
hosted_subscription=warehouse_from_mac

if [[ "${mode}" == prepare ]]; then
  [[ "${WAREHOUSE_CONFIRM_REVERSE_PREPARE:-}" == YES ]] || {
    printf 'prepare requires WAREHOUSE_CONFIRM_REVERSE_PREPARE=YES\n' >&2
    exit 2
  }
  : "${WAREHOUSE_CONTROL_REPL_PASSWORD:?control replication password is required}"
  : "${WAREHOUSE_HOSTED_REPL_PASSWORD:?hosted replication password is required}"
fi
if [[ "${mode}" == enable ]]; then
  [[ "${WAREHOUSE_CONFIRM_REVERSE_ENABLE:-}" == YES ]] || {
    printf 'enable requires WAREHOUSE_CONFIRM_REVERSE_ENABLE=YES after fencing Vultr and disabling Mac forward subscriptions\n' >&2
    exit 2
  }
fi
if [[ "${mode}" == disable ]]; then
  [[ "${WAREHOUSE_CONFIRM_REVERSE_DISABLE:-}" == YES ]] || {
    printf 'disable requires WAREHOUSE_CONFIRM_REVERSE_DISABLE=YES\n' >&2
    exit 2
  }
fi

control_psql() {
  docker exec "${control_container}" sh -lc \
    'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"' sh "$@"
}

hosted_psql() {
  local database="$1"
  shift
  docker exec -e TARGET_DATABASE="${database}" "${hosted_container}" sh -lc \
    'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$TARGET_DATABASE" "$@"' sh "$@"
}

databases="$(docker exec "${hosted_container}" sh -lc \
  'psql -X -At -U "$POSTGRES_USER" -d postgres -c "select datname from pg_database where datname ~ '\''^whdb_[0-9a-f]{32}$'\'' order by 1"')"
[[ -n "${databases}" ]] || {
  printf 'no hosted databases found\n' >&2
  exit 2
}
database_count="$(printf '%s\n' "${databases}" | sed '/^$/d' | wc -l | tr -d ' ')"

prepare_control() {
  local existing metadata publisher_tables local_tables
  export PGPASSWORD="${WAREHOUSE_CONTROL_REPL_PASSWORD}"
  publisher_tables="$(docker exec -e PGPASSWORD "${control_container}" psql -X -At \
    -h "${publisher_host}" -p "${control_port}" -U warehouse_control_replica \
    -d warehouse_os -c "select count(*) from pg_publication_tables where pubname='warehouse_control_pub'")"
  local_tables="$(control_psql -At -c \
    "select count(*) from pg_tables where schemaname <> 'information_schema' and schemaname not like 'pg_%'")"
  [[ "${publisher_tables}" =~ ^[1-9][0-9]*$ && "${publisher_tables}" == "${local_tables}" ]] || {
    printf 'control table inventory mismatch publisher=%s local=%s\n' \
      "${publisher_tables}" "${local_tables}" >&2
    exit 2
  }
  existing="$(control_psql -At -c \
    "select count(*) from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${control_subscription}'")"
  if [[ "${existing}" == 0 ]]; then
    export PUBLISHER_PASSWORD="${WAREHOUSE_CONTROL_REPL_PASSWORD}"
    docker exec -i \
      -e PUBLISHER_PASSWORD -e PUBLISHER_HOST="${publisher_host}" \
      -e PUBLISHER_PORT="${control_port}" \
      "${control_container}" sh -lc \
      'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <<'SQL'
\getenv publisher_password PUBLISHER_PASSWORD
\getenv publisher_host PUBLISHER_HOST
\getenv publisher_port PUBLISHER_PORT
\set publisher_conninfo 'host=' :publisher_host ' port=' :publisher_port ' dbname=warehouse_os user=warehouse_control_replica password=' :publisher_password ' connect_timeout=10 sslmode=disable application_name=vultr-control-subscriber'
CREATE SUBSCRIPTION warehouse_from_mac
  CONNECTION :'publisher_conninfo'
  PUBLICATION warehouse_control_pub
  WITH (
    copy_data=false,
    create_slot=true,
    enabled=false,
    run_as_owner=true,
    slot_name='vultr_control',
    streaming=parallel,
    origin=none
  );
SQL
  elif [[ "${existing}" != 1 ]]; then
    printf 'unexpected control reverse subscription count=%s\n' "${existing}" >&2
    exit 2
  fi
  metadata="$(control_psql -At -c \
    "select subslotname,subenabled,subrunasowner,substream::text,suborigin from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${control_subscription}'")"
  [[ "${metadata}" == 'vultr_control|f|t|p|none' ]] || {
    printf 'unexpected control reverse subscription metadata=%s\n' "${metadata}" >&2
    exit 2
  }
}

prepare_hosted() {
  local database existing metadata publisher_tables local_tables slot_name
  export PGPASSWORD="${WAREHOUSE_HOSTED_REPL_PASSWORD}"
  while IFS= read -r database; do
    [[ "${database}" =~ ^whdb_[0-9a-f]{32}$ ]] || exit 2
    publisher_tables="$(docker exec -e PGPASSWORD "${hosted_container}" psql -X -At \
      -h "${publisher_host}" -p "${hosted_port}" -U warehouse_hosted_replica \
      -d "${database}" -c "select count(*) from pg_publication_tables where pubname='warehouse_hosted_pub'")"
    local_tables="$(hosted_psql "${database}" -At -c \
      "select count(*) from pg_tables where schemaname <> 'information_schema' and schemaname not like 'pg_%'")"
    [[ "${publisher_tables}" =~ ^[1-9][0-9]*$ && "${publisher_tables}" == "${local_tables}" ]] || {
      printf 'hosted table inventory mismatch database=%s publisher=%s local=%s\n' \
        "${database}" "${publisher_tables}" "${local_tables}" >&2
      exit 2
    }
    existing="$(hosted_psql "${database}" -At -c \
      "select count(*) from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${hosted_subscription}'")"
    slot_name="vultr_${database#whdb_}"
    if [[ "${existing}" == 0 ]]; then
      export PUBLISHER_PASSWORD="${WAREHOUSE_HOSTED_REPL_PASSWORD}"
      docker exec -i \
        -e PUBLISHER_PASSWORD -e PUBLISHER_HOST="${publisher_host}" \
        -e PUBLISHER_PORT="${hosted_port}" -e TARGET_DATABASE="${database}" \
        -e SLOT_NAME="${slot_name}" \
        "${hosted_container}" sh -lc \
        'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$TARGET_DATABASE"' <<'SQL'
\getenv publisher_password PUBLISHER_PASSWORD
\getenv publisher_host PUBLISHER_HOST
\getenv publisher_port PUBLISHER_PORT
\getenv target_database TARGET_DATABASE
\getenv slot_name SLOT_NAME
\set publisher_conninfo 'host=' :publisher_host ' port=' :publisher_port ' dbname=' :target_database ' user=warehouse_hosted_replica password=' :publisher_password ' connect_timeout=10 sslmode=disable application_name=vultr-hosted-subscriber'
CREATE SUBSCRIPTION warehouse_from_mac
  CONNECTION :'publisher_conninfo'
  PUBLICATION warehouse_hosted_pub
  WITH (
    copy_data=false,
    create_slot=true,
    enabled=false,
    run_as_owner=true,
    slot_name=:'slot_name',
    streaming=parallel,
    origin=none
  );
SQL
    elif [[ "${existing}" != 1 ]]; then
      printf 'unexpected hosted reverse subscription count database=%s count=%s\n' \
        "${database}" "${existing}" >&2
      exit 2
    fi
    metadata="$(hosted_psql "${database}" -At -c \
      "select subslotname,subenabled,subrunasowner,substream::text,suborigin from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${hosted_subscription}'")"
    [[ "${metadata}" == "${slot_name}|f|t|p|none" ]] || {
      printf 'unexpected hosted reverse subscription metadata database=%s metadata=%s\n' \
        "${database}" "${metadata}" >&2
      exit 2
    }
    printf 'reverse_subscription_prepared=%s/%s database=%s tables=%s\n' \
      "$((++prepared_hosted))" "${database_count}" "${database}" "${publisher_tables}"
  done <<<"${databases}"
}

set_state() {
  local action="$1" database
  control_psql -c "ALTER SUBSCRIPTION ${control_subscription} ${action}" >/dev/null
  while IFS= read -r database; do
    hosted_psql "${database}" -c \
      "ALTER SUBSCRIPTION ${hosted_subscription} ${action}" >/dev/null
  done <<<"${databases}"
}

verify_state() {
  local control_meta hosted_total hosted_enabled hosted_workers database
  control_meta="$(control_psql -At -c \
    "select count(*),count(*) filter (where subenabled),(select count(*) from pg_stat_subscription where pid is not null and relid is null and subid in (select oid from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${control_subscription}')) from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${control_subscription}'")"
  hosted_total=0
  hosted_enabled=0
  hosted_workers=0
  while IFS= read -r database; do
    IFS='|' read -r total enabled workers <<<"$(hosted_psql "${database}" -At -c \
      "select count(*),count(*) filter (where subenabled),(select count(*) from pg_stat_subscription where pid is not null and relid is null and subid in (select oid from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${hosted_subscription}')) from pg_subscription where subdbid=(select oid from pg_database where datname=current_database()) and subname='${hosted_subscription}'")"
    hosted_total=$((hosted_total + total))
    hosted_enabled=$((hosted_enabled + enabled))
    hosted_workers=$((hosted_workers + workers))
  done <<<"${databases}"
  printf 'control_reverse=%s\n' "${control_meta}"
  printf 'hosted_reverse=%s|%s|%s\n' "${hosted_total}" "${hosted_enabled}" "${hosted_workers}"
}

case "${mode}" in
  prepare)
    prepared_hosted=0
    prepare_control
    prepare_hosted
    ;;
  enable) set_state ENABLE ;;
  disable) set_state DISABLE ;;
  verify) ;;
esac

verify_state
