#!/usr/bin/env bash
set -Eeuo pipefail

container="${HOSTED_POSTGRES_CONTAINER:-warehouse-os-hosted-postgres}"
role="warehouse_hosted_replica"
publication="warehouse_hosted_pub"
: "${REPL_PASSWORD:?REPL_PASSWORD is required}"

docker exec -i -e REPL_PASSWORD "${container}" sh -lc \
  'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres --set=repl_password="$REPL_PASSWORD"' <<'SQL'
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'warehouse_hosted_replica') THEN
    CREATE ROLE warehouse_hosted_replica LOGIN REPLICATION BYPASSRLS;
  END IF;
END
$$;
ALTER ROLE warehouse_hosted_replica
  WITH LOGIN REPLICATION BYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE
  PASSWORD :'repl_password';
SQL

mapfile -t databases < <(
  docker exec "${container}" sh -lc \
    'psql -U "$POSTGRES_USER" -d postgres -Atc "SELECT datname FROM pg_database WHERE starts_with(datname, chr(119)||chr(104)||chr(100)||chr(98)||chr(95)) ORDER BY datname"'
)

for database in "${databases[@]}"; do
  [[ "${database}" =~ ^whdb_[0-9a-f]{32}$ ]] || {
    printf 'refusing unexpected hosted database: %s\n' "${database}" >&2
    exit 2
  }
  docker exec -i -e TARGET_DATABASE="${database}" "${container}" sh -lc \
    'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$TARGET_DATABASE"' <<'SQL'
SELECT format(
  'GRANT CONNECT ON DATABASE %I TO warehouse_hosted_replica',
  current_database()
) \gexec
DO $$
DECLARE schema_name text;
DECLARE owner_name text;
DECLARE target_table record;
BEGIN
  FOR schema_name IN
    SELECT nspname FROM pg_namespace
    WHERE nspname <> 'information_schema' AND nspname NOT LIKE 'pg_%'
  LOOP
    EXECUTE format('GRANT USAGE ON SCHEMA %I TO warehouse_hosted_replica', schema_name);
    EXECUTE format('GRANT SELECT ON ALL TABLES IN SCHEMA %I TO warehouse_hosted_replica', schema_name);
    EXECUTE format('GRANT SELECT ON ALL SEQUENCES IN SCHEMA %I TO warehouse_hosted_replica', schema_name);
    FOR owner_name IN
      SELECT DISTINCT tableowner FROM pg_tables WHERE schemaname = schema_name
    LOOP
      EXECUTE format(
        'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA %I GRANT SELECT ON TABLES TO warehouse_hosted_replica',
        owner_name,
        schema_name
      );
      EXECUTE format(
        'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA %I GRANT SELECT ON SEQUENCES TO warehouse_hosted_replica',
        owner_name,
        schema_name
      );
    END LOOP;
  END LOOP;

  -- UPDATE and DELETE replication requires a usable replica identity.  Hosted
  -- schemas are application-owned and some tables intentionally have no
  -- primary key, so make those tables self-contained for logical failover.
  FOR target_table IN
    SELECT namespace.nspname AS schema_name, relation.relname AS table_name
    FROM pg_class AS relation
    JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
    WHERE relation.relkind IN ('r', 'p')
      AND relation.relpersistence = 'p'
      AND relation.relreplident <> 'f'
      AND namespace.nspname <> 'information_schema'
      AND namespace.nspname NOT LIKE 'pg_%'
      AND NOT EXISTS (
        SELECT 1
        FROM pg_index AS identity_index
        WHERE identity_index.indrelid = relation.oid
          AND identity_index.indisprimary
      )
  LOOP
    EXECUTE format(
      'ALTER TABLE %I.%I REPLICA IDENTITY FULL',
      target_table.schema_name,
      target_table.table_name
    );
  END LOOP;
END
$$;
SELECT 'CREATE PUBLICATION warehouse_hosted_pub FOR ALL TABLES'
WHERE NOT EXISTS (
  SELECT 1 FROM pg_publication WHERE pubname = 'warehouse_hosted_pub'
) \gexec

DO $$
BEGIN
  IF EXISTS (
    SELECT 1
    FROM pg_class AS relation
    JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
    WHERE relation.relkind IN ('r', 'p')
      AND relation.relpersistence = 'p'
      AND relation.relreplident <> 'f'
      AND namespace.nspname <> 'information_schema'
      AND namespace.nspname NOT LIKE 'pg_%'
      AND NOT EXISTS (
        SELECT 1
        FROM pg_index AS identity_index
        WHERE identity_index.indrelid = relation.oid
          AND identity_index.indisprimary
      )
  ) THEN
    RAISE EXCEPTION 'hosted publication contains tables without a replica identity';
  END IF;
END
$$;
SQL
done

printf 'configured_databases=%s\nrole=%s\npublication=%s\n' \
  "${#databases[@]}" "${role}" "${publication}"
