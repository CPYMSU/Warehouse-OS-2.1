#!/bin/zsh
set -Eeuo pipefail

[[ "$(uname -s)" == Darwin ]] || {
  print -u2 'this publisher configurator is only for macOS'
  exit 2
}
: "${WAREHOUSE_CONTROL_REPL_PASSWORD:?control replication password is required}"
: "${WAREHOUSE_HOSTED_REPL_PASSWORD:?hosted replication password is required}"
: "${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD:?local hosted admin password is required}"
[[ "${WAREHOUSE_CONTROL_REPL_PASSWORD}" =~ ^[0-9a-f]{64}$ ]] || {
  print -u2 'control replication password is malformed'
  exit 2
}
[[ "${WAREHOUSE_HOSTED_REPL_PASSWORD}" =~ ^[0-9a-f]{64}$ ]] || {
  print -u2 'hosted replication password is malformed'
  exit 2
}

PSQL="${PSQL_BIN:-/opt/homebrew/opt/postgresql@18/bin/psql}"
export WAREHOUSE_CONTROL_REPL_PASSWORD WAREHOUSE_HOSTED_REPL_PASSWORD

"${PSQL}" -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -p 5432 \
  -U peiyuan -d warehouse_os <<'SQL'
\getenv repl_password WAREHOUSE_CONTROL_REPL_PASSWORD
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='warehouse_control_replica') THEN
    CREATE ROLE warehouse_control_replica LOGIN REPLICATION BYPASSRLS;
  END IF;
END
$$;
ALTER ROLE warehouse_control_replica
  WITH LOGIN REPLICATION BYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE
  PASSWORD :'repl_password';
GRANT CONNECT ON DATABASE warehouse_os TO warehouse_control_replica;
DO $$
DECLARE schema_name text;
DECLARE owner_name text;
DECLARE target_table record;
BEGIN
  FOR schema_name IN
    SELECT nspname FROM pg_namespace
    WHERE nspname <> 'information_schema' AND nspname NOT LIKE 'pg_%'
  LOOP
    EXECUTE format('GRANT USAGE ON SCHEMA %I TO warehouse_control_replica', schema_name);
    EXECUTE format('GRANT SELECT ON ALL TABLES IN SCHEMA %I TO warehouse_control_replica', schema_name);
    EXECUTE format('GRANT SELECT ON ALL SEQUENCES IN SCHEMA %I TO warehouse_control_replica', schema_name);
    FOR owner_name IN
      SELECT DISTINCT tableowner FROM pg_tables WHERE schemaname=schema_name
    LOOP
      EXECUTE format(
        'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA %I GRANT SELECT ON TABLES TO warehouse_control_replica',
        owner_name, schema_name
      );
      EXECUTE format(
        'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA %I GRANT SELECT ON SEQUENCES TO warehouse_control_replica',
        owner_name, schema_name
      );
    END LOOP;
  END LOOP;
  FOR target_table IN
    SELECT n.nspname AS schema_name, c.relname AS table_name
    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE c.relkind IN ('r','p') AND c.relpersistence='p'
      AND c.relreplident <> 'f'
      AND n.nspname <> 'information_schema' AND n.nspname NOT LIKE 'pg_%'
      AND NOT EXISTS (
        SELECT 1 FROM pg_index i WHERE i.indrelid=c.oid AND i.indisprimary
      )
  LOOP
    EXECUTE format('ALTER TABLE %I.%I REPLICA IDENTITY FULL',
      target_table.schema_name, target_table.table_name);
  END LOOP;
END
$$;
SELECT 'CREATE PUBLICATION warehouse_control_pub FOR ALL TABLES'
WHERE NOT EXISTS (
  SELECT 1 FROM pg_publication WHERE pubname='warehouse_control_pub'
) \gexec
SQL

PGPASSWORD="${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD}" \
  "${PSQL}" -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -p 5433 \
    -U warehouse_hosted_admin -d postgres <<'SQL'
\getenv repl_password WAREHOUSE_HOSTED_REPL_PASSWORD
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='warehouse_hosted_replica') THEN
    CREATE ROLE warehouse_hosted_replica LOGIN REPLICATION BYPASSRLS;
  END IF;
END
$$;
ALTER ROLE warehouse_hosted_replica
  WITH LOGIN REPLICATION BYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE
  PASSWORD :'repl_password';
SQL

databases="$(PGPASSWORD="${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD}" \
  "${PSQL}" -X -At -h 127.0.0.1 -p 5433 -U warehouse_hosted_admin \
    -d postgres -c "select datname from pg_database where datname ~ '^whdb_[0-9a-f]{32}$' order by 1")"
[[ -n "${databases}" ]] || {
  print -u2 'no hosted databases found'
  exit 2
}

configured=0
while IFS= read -r database; do
  [[ "${database}" =~ ^whdb_[0-9a-f]{32}$ ]] || {
    print -u2 "refusing unexpected hosted database: ${database}"
    exit 2
  }
  PGPASSWORD="${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD}" \
    "${PSQL}" -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -p 5433 \
      -U warehouse_hosted_admin -d "${database}" <<'SQL'
GRANT CONNECT ON DATABASE :DBNAME TO warehouse_hosted_replica;
DO $$
DECLARE schema_name text;
DECLARE owner_name text;
DECLARE target_table record;
BEGIN
  FOR schema_name IN
    SELECT nspname FROM pg_namespace
    WHERE nspname <> 'information_schema' AND nspname NOT LIKE 'pg_%'
  LOOP
    EXECUTE format('GRANT USAGE ON SCHEMA %I TO warehouse_hosted_replica', schema_name);
    EXECUTE format('GRANT SELECT ON ALL TABLES IN SCHEMA %I TO warehouse_hosted_replica', schema_name);
    EXECUTE format('GRANT SELECT ON ALL SEQUENCES IN SCHEMA %I TO warehouse_hosted_replica', schema_name);
    FOR owner_name IN
      SELECT DISTINCT tableowner FROM pg_tables WHERE schemaname=schema_name
    LOOP
      EXECUTE format(
        'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA %I GRANT SELECT ON TABLES TO warehouse_hosted_replica',
        owner_name, schema_name
      );
      EXECUTE format(
        'ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA %I GRANT SELECT ON SEQUENCES TO warehouse_hosted_replica',
        owner_name, schema_name
      );
    END LOOP;
  END LOOP;
  FOR target_table IN
    SELECT n.nspname AS schema_name, c.relname AS table_name
    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE c.relkind IN ('r','p') AND c.relpersistence='p'
      AND c.relreplident <> 'f'
      AND n.nspname <> 'information_schema' AND n.nspname NOT LIKE 'pg_%'
      AND NOT EXISTS (
        SELECT 1 FROM pg_index i WHERE i.indrelid=c.oid AND i.indisprimary
      )
  LOOP
    EXECUTE format('ALTER TABLE %I.%I REPLICA IDENTITY FULL',
      target_table.schema_name, target_table.table_name);
  END LOOP;
END
$$;
SELECT 'CREATE PUBLICATION warehouse_hosted_pub FOR ALL TABLES'
WHERE NOT EXISTS (
  SELECT 1 FROM pg_publication WHERE pubname='warehouse_hosted_pub'
) \gexec
SQL
  (( configured += 1 ))
done <<<"${databases}"

control_tables="$(${PSQL} -X -At -h 127.0.0.1 -p 5432 -U peiyuan \
  -d warehouse_os -c "select count(*) from pg_publication_tables where pubname='warehouse_control_pub'")"
hosted_tables=0
while IFS= read -r database; do
  count="$(PGPASSWORD="${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD}" \
    "${PSQL}" -X -At -h 127.0.0.1 -p 5433 -U warehouse_hosted_admin \
      -d "${database}" -c "select count(*) from pg_publication_tables where pubname='warehouse_hosted_pub'")"
  (( hosted_tables += count ))
done <<<"${databases}"

print "macos_publications=ready"
print "control_tables=${control_tables}"
print "hosted_databases=${configured}"
print "hosted_tables=${hosted_tables}"
