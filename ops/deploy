#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-smart}"
DEPLOY_ACTION=install
MODE="${COMMAND}"
if [[ "${COMMAND}" == prepare ]]; then
  [[ "$#" -eq 2 ]] || {
    printf 'deploy error: usage: ops/deploy prepare smart|quick|standard|full\n' >&2
    exit 1
  }
  DEPLOY_ACTION=prepare
  MODE="$2"
fi
LOCAL_VALIDATION="${WAREHOUSE_DEPLOY_LOCAL_VALIDATION:-adaptive}"
TARGET="${WAREHOUSE_DEPLOY_TARGET:-vultr-production}"
TRANSPORT="${WAREHOUSE_DEPLOY_TRANSPORT:-ssh}"
HOST="${WAREHOUSE_DEPLOY_HOST:-207.148.120.30}"
USER="${WAREHOUSE_DEPLOY_USER:-warehouse-deploy}"
IDENTITY="${WAREHOUSE_DEPLOY_IDENTITY:-${HOME}/.ssh/warehouse_os_deploy_ed25519}"
KNOWN_HOSTS="${WAREHOUSE_DEPLOY_KNOWN_HOSTS:-${HOME}/.ssh/known_hosts}"
REMOTE_MANAGER="${WAREHOUSE_REMOTE_DEPLOY_MANAGER:-/usr/local/sbin/warehouse-deploy}"
REMOTE_INCOMING="${WAREHOUSE_DEPLOY_INCOMING:-/var/lib/warehouse-deploy/incoming}"
MANAGER_SUDO="${WAREHOUSE_DEPLOY_MANAGER_SUDO:-1}"
PREPARE_INCOMING="${WAREHOUSE_DEPLOY_PREPARE_INCOMING:-1}"
SCP_LEGACY="${WAREHOUSE_DEPLOY_SCP_LEGACY:-0}"
ALEMBIC="${WAREHOUSE_DEPLOY_ALEMBIC:-${ROOT}/backend/.venv/bin/alembic}"
if [[ ! -x "${ALEMBIC}" ]]; then
  ALEMBIC="${ROOT}/ops/alembic-head"
fi
RELEASE_ID_FILE="${WAREHOUSE_DEPLOY_RELEASE_ID_FILE:-}"

ssh_options=(
  -F /dev/null
  -i "${IDENTITY}"
  -o BatchMode=yes
  -o IdentitiesOnly=yes
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="${KNOWN_HOSTS}"
  -o ConnectTimeout=15
  -o ServerAliveInterval=20
  -o ServerAliveCountMax=3
)

usage() {
  cat <<'EOF'
Usage:
  ops/deploy smart       # change-aware tests and evidence-driven server verification
  ops/deploy quick       # frontend or low-risk application change
  ops/deploy standard    # manually force the complete non-destructive suite
  ops/deploy full        # disposable PG18 integration suite plus full server checks
  ops/deploy prepare smart # validate, back up, build and health-check without switching
  ops/deploy prepared-status RELEASE # verify a prepared candidate remains healthy
  ops/deploy activate RELEASE # atomically switch to an already prepared candidate
  ops/deploy plan        # compare this checkout with the target's active manifest
  ops/deploy status      # current release, slots and service health
  ops/deploy runtime-status # Runtime Controller state and recent logs
  ops/deploy api-logs    # active API slot recent logs
  ops/deploy history     # recent deployment audit events
  ops/deploy rollback    # atomically return to the previous healthy slot
  ops/deploy storage-activate # verify HDD and additively copy legacy hosted objects
  ops/deploy hosted-db-activate # start the isolated HDD PostgreSQL data plane
  ops/deploy hosted-db-migrate  # migrate legacy workspace records after both slots are ready
  ops/deploy backup-now         # back up and verify both PostgreSQL data planes
  ops/deploy workspace-db-inspect ASSET_NO
  ops/deploy workspace-db-capabilities ASSET_NO
  ops/deploy workspace-db-backup ASSET_NO
  ops/deploy workspace-db-migrate-source ASSET_NO SOURCE_PATH VERSION
  ops/deploy workspace-deploy-latest ASSET_NO
  ops/deploy workspace-accept ASSET_NO DEPLOYMENT_ID EXPECTED_MODULES EXPECTED_RESOURCES
  ops/deploy workspace-activate ASSET_NO DEPLOYMENT_ID
  ops/deploy workspace-environment ASSET_NO NAME VALUE
  ops/deploy workspace-stage-python ASSET_NO SOURCE_VERSION_ID
  ops/deploy workspace-job ASSET_NO SOURCE_VERSION_ID alembic-upgrade|catalog-import
  ops/deploy workspace-source-read ASSET_NO SOURCE_PATH

Environment:
  WAREHOUSE_DEPLOY_HOST
  WAREHOUSE_DEPLOY_USER
  WAREHOUSE_DEPLOY_IDENTITY
  WAREHOUSE_DEPLOY_KNOWN_HOSTS
  WAREHOUSE_DEPLOY_TARGET
  WAREHOUSE_DEPLOY_TRANSPORT         # ssh (default) or local
  WAREHOUSE_DEPLOY_INCOMING
  WAREHOUSE_DEPLOY_MANAGER_SUDO      # 1 for sudo -n, 0 for an unprivileged manager
  WAREHOUSE_DEPLOY_PREPARE_INCOMING  # 1 to create the incoming directory, 0 if pre-provisioned
  WAREHOUSE_DEPLOY_SCP_LEGACY        # 1 for scp -O when a forced-command gate is used
  WAREHOUSE_DEPLOY_LOCAL_VALIDATION  # adaptive (local default) or basic (GitHub)
  WAREHOUSE_DEPLOY_ALEMBIC           # absolute Alembic executable used for release evidence
  WAREHOUSE_DEPLOY_RELEASE_ID_FILE   # optional controller-owned output path for prepare
EOF
}

fail() {
  printf 'deploy error: %s\n' "$*" >&2
  exit 1
}

remote() {
  ssh "${ssh_options[@]}" "${USER}@${HOST}" "$@"
}

manager_remote() {
  if [[ "${TRANSPORT}" == local ]]; then
    if [[ "${MANAGER_SUDO}" == 1 ]]; then
      sudo -n "${REMOTE_MANAGER}" "$@"
    else
      "${REMOTE_MANAGER}" "$@"
    fi
    return
  fi
  local command argument quoted
  printf -v command '%q' "${REMOTE_MANAGER}"
  for argument in "$@"; do
    printf -v quoted '%q' "${argument}"
    command+=" ${quoted}"
  done
  if [[ "${MANAGER_SUDO}" == 1 ]]; then
    command="sudo -n ${command}"
  fi
  remote "${command}"
}

require_file() {
  [[ -f "$1" ]] || fail "required file not found: $1"
}

require_deploy_access() {
  if [[ "${TRANSPORT}" == ssh ]]; then
    require_file "${IDENTITY}"
    require_file "${KNOWN_HOSTS}"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

[[ "${TARGET}" =~ ^[A-Za-z0-9._-]{1,40}$ ]] \
  || fail "WAREHOUSE_DEPLOY_TARGET is invalid"
[[ "${TRANSPORT}" =~ ^(ssh|local)$ ]] \
  || fail "WAREHOUSE_DEPLOY_TRANSPORT must be ssh or local"
if [[ "${TRANSPORT}" == ssh ]]; then
  [[ -n "${HOST}" && "${HOST}" != *[[:space:]]* ]] \
    || fail "WAREHOUSE_DEPLOY_HOST is invalid"
  [[ "${USER}" =~ ^[A-Za-z_][A-Za-z0-9._-]{0,63}$ ]] \
    || fail "WAREHOUSE_DEPLOY_USER is invalid"
fi
[[ "${REMOTE_MANAGER}" == /* && "${REMOTE_MANAGER}" != *[[:space:]]* ]] \
  || fail "WAREHOUSE_REMOTE_DEPLOY_MANAGER must be an absolute path without whitespace"
[[ "${REMOTE_INCOMING}" == /* && "${REMOTE_INCOMING}" != *[[:space:]]* \
    && "${REMOTE_INCOMING}" != *../* && "${REMOTE_INCOMING}" != */.. ]] \
  || fail "WAREHOUSE_DEPLOY_INCOMING must be a safe absolute path without whitespace"
[[ "${MANAGER_SUDO}" =~ ^[01]$ ]] \
  || fail "WAREHOUSE_DEPLOY_MANAGER_SUDO must be 0 or 1"
[[ "${PREPARE_INCOMING}" =~ ^[01]$ ]] \
  || fail "WAREHOUSE_DEPLOY_PREPARE_INCOMING must be 0 or 1"
[[ "${SCP_LEGACY}" =~ ^[01]$ ]] \
  || fail "WAREHOUSE_DEPLOY_SCP_LEGACY must be 0 or 1"

case "${MODE}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  status|runtime-status|api-logs|history|rollback)
    require_deploy_access
    manager_remote "${MODE}"
    exit 0
    ;;
  prepared-status|activate)
    [[ "$#" -eq 2 ]] || fail "${MODE} requires RELEASE"
    require_deploy_access
    manager_remote "${MODE}" "$2"
    exit 0
    ;;
  plan)
    require_deploy_access
    require_command python3
    plan_dir="$(mktemp -d "${TMPDIR:-/tmp}/warehouse-deploy-plan.XXXXXX")"
    trap 'rm -rf "${plan_dir}"' EXIT
    manager_remote manifest > "${plan_dir}/active-files.sha256"
    [[ -s "${plan_dir}/active-files.sha256" ]] \
      || fail "target active manifest is empty"
    "${ROOT}/ops/deploy-plan" \
      --base-manifest "${plan_dir}/active-files.sha256" \
      --candidate-root "${ROOT}" \
      --format json
    exit 0
    ;;
  storage-activate)
    require_deploy_access
    manager_remote activate-hosted-storage
    exit 0
    ;;
  hosted-db-activate)
    require_deploy_access
    manager_remote activate-hosted-database
    exit 0
    ;;
  hosted-db-migrate)
    require_deploy_access
    manager_remote migrate-hosted-databases
    exit 0
    ;;
  backup-now)
    require_deploy_access
    manager_remote backup-now
    exit 0
    ;;
  workspace-db-inspect|workspace-db-capabilities|workspace-db-backup)
    [[ "$#" -eq 2 ]] || fail "${MODE} requires ASSET_NO"
    require_deploy_access
    operation="${MODE#workspace-db-}"
    manager_remote workspace-database "${operation}" "$2"
    exit 0
    ;;
  workspace-db-migrate-source)
    [[ "$#" -eq 4 ]] || fail "workspace-db-migrate-source requires ASSET_NO SOURCE_PATH VERSION"
    require_deploy_access
    manager_remote workspace-database-migrate-source "$2" "$3" "$4"
    exit 0
    ;;
  workspace-deploy-latest)
    [[ "$#" -eq 2 ]] || fail "workspace-deploy-latest requires ASSET_NO"
    require_deploy_access
    manager_remote workspace-deploy-latest "$2"
    exit 0
    ;;
  workspace-accept)
    [[ "$#" -eq 5 ]] \
      || fail "workspace-accept requires ASSET_NO DEPLOYMENT_ID EXPECTED_MODULES EXPECTED_RESOURCES"
    [[ "$4" =~ ^[0-9]{1,4}$ && "$5" =~ ^[0-9]{1,6}$ ]] \
      || fail "workspace-accept counts must be non-negative integers"
    require_deploy_access
    manager_remote workspace-accept "$2" "$3" "$4" "$5"
    exit 0
    ;;
  workspace-activate)
    [[ "$#" -eq 3 ]] || fail "workspace-activate requires ASSET_NO DEPLOYMENT_ID"
    require_deploy_access
    manager_remote workspace-activate "$2" "$3"
    exit 0
    ;;
  workspace-environment)
    [[ "$#" -eq 4 ]] || fail "workspace-environment requires ASSET_NO NAME VALUE"
    [[ "$3" =~ ^[A-Z][A-Z0-9_]{0,79}$ ]] \
      || fail "workspace-environment NAME is invalid"
    require_deploy_access
    manager_remote workspace-environment "$2" "$3" "$4"
    exit 0
    ;;
  workspace-stage-python)
    [[ "$#" -eq 3 ]] || fail "workspace-stage-python requires ASSET_NO SOURCE_VERSION_ID"
    require_deploy_access
    manager_remote workspace-stage-python "$2" "$3"
    exit 0
    ;;
  workspace-job)
    [[ "$#" -eq 4 ]] \
      || fail "workspace-job requires ASSET_NO SOURCE_VERSION_ID JOB_KIND"
    [[ "$4" =~ ^(alembic-upgrade|catalog-import)$ ]] \
      || fail "workspace-job JOB_KIND must be alembic-upgrade or catalog-import"
    require_deploy_access
    manager_remote workspace-job "$2" "$3" "$4"
    exit 0
    ;;
  workspace-source-read)
    [[ "$#" -eq 3 ]] || fail "workspace-source-read requires ASSET_NO SOURCE_PATH"
    require_deploy_access
    manager_remote workspace-source-read "$2" "$3"
    exit 0
    ;;
  smart|quick|standard|full)
    ;;
  *)
    usage >&2
    fail "unknown mode: ${MODE}"
    ;;
esac

require_deploy_access
require_command node
require_command rsync
if [[ "${TRANSPORT}" == ssh ]]; then
  require_command ssh
  require_command scp
fi
require_command shasum
require_command python3

case "${LOCAL_VALIDATION}" in
  adaptive|basic) ;;
  *) fail "unknown local validation policy: ${LOCAL_VALIDATION}" ;;
esac

deploy_started="${SECONDS}"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/warehouse-deploy.XXXXXX")"
stage_dir="${work_dir}/stage"

cleanup() {
  rm -rf "${work_dir}"
}
trap cleanup EXIT

printf '==> local validation (%s)\n' "${MODE}"
cd "${ROOT}"
git diff --check

PLAN_MODE="${MODE}"
PLAN_RISK="manual"
PLAN_DEPLOY_REQUIRED=1
PLAN_TESTS=""
PLAN_FRONTEND=1
PLAN_INTEGRATION=0
PLAN_CHANGED_COUNT=0
PLAN_UNMATCHED_FILES=""
PLAN_SOURCE="explicit"
INSTALL_MODE="${MODE}"

if [[ "${MODE}" == smart ]]; then
  # The model is deterministic and versioned with the release. It also tells
  # the trusted server which safety checks are required for this release.
  active_manifest="${work_dir}/active-files.sha256"
  if manager_remote manifest \
    > "${active_manifest}" 2>/dev/null && [[ -s "${active_manifest}" ]]; then
    eval "$(
      ops/deploy-plan \
        --base-manifest "${active_manifest}" \
        --candidate-root "${ROOT}" \
        --format shell
    )"
    PLAN_SOURCE="active_release"
  else
    if [[ "${WAREHOUSE_REQUIRE_ACTIVE_MANIFEST:-0}" == 1 ]]; then
      fail "active release manifest is required but unavailable"
    fi
    eval "$(ops/deploy-plan --format shell)"
    PLAN_SOURCE="git_fallback"
    # The currently installed server manager may predate the smart contract.
    # Bootstrap it through the conservative legacy lane selected above.
    INSTALL_MODE="${PLAN_MODE}"
  fi
  printf '    plan: source=%s risk=%s lane=%s files=%s\n' \
    "${PLAN_SOURCE}" "${PLAN_RISK}" "${PLAN_MODE}" "${PLAN_CHANGED_COUNT}"
  if [[ -n "${PLAN_UNMATCHED_FILES}" ]]; then
    printf '    unmatched (server applies conservative checks): %s\n' \
      "${PLAN_UNMATCHED_FILES}"
  fi
  if [[ "${PLAN_DEPLOY_REQUIRED}" != 1 ]]; then
    printf '==> no runtime deployment required for the observed change set\n'
    exit 0
  fi
fi

phase_started="${SECONDS}"
if [[ "${LOCAL_VALIDATION}" == basic ]]; then
  node scripts/build_v2_frontend.cjs --check
else
  if [[ "${PLAN_FRONTEND}" == 1 || "${MODE}" != smart ]]; then
    node scripts/build_v2_frontend.cjs
  fi
  if [[ "${MODE}" != smart ]]; then
    node scripts/build_v2_frontend.cjs --check
  fi
fi
printf '    phase=frontend duration_seconds=%s\n' "$((SECONDS - phase_started))"

phase_started="${SECONDS}"
if [[ "${LOCAL_VALIDATION}" == basic ]]; then
  PYTHONPYCACHEPREFIX="${work_dir}/python-cache" \
    python3 -m compileall -q backend/app backend/alembic/versions
  bash -n \
    ops/deploy \
    ops/cluster/rolling-deploy \
    ops/macos/warehouse-deploy-macos \
    ops/macos/warehouse-deploy-ssh-gate \
    ops/run-full-verification \
    ops/server/warehouse-deploy \
    infra/backup/warehouse-postgres-backup.sh
else
  case "${MODE}" in
    smart)
      IFS=: read -r -a smart_tests <<< "${PLAN_TESTS}"
      if [[ ${#smart_tests[@]} -eq 0 ]]; then
        smart_tests=(backend/tests/test_config.py)
      fi
      if [[ "${PLAN_INTEGRATION}" == 1 ]]; then
        verification_targets=()
        for target in "${smart_tests[@]}"; do
          verification_targets+=("${target#backend/}")
        done
        ops/run-full-verification "${verification_targets[@]}"
      else
        backend/.venv/bin/pytest -q "${smart_tests[@]}"
      fi
      ;;
    quick)
      backend/.venv/bin/pytest -q \
        backend/tests/test_config.py \
        backend/tests/test_frontend_api_contract.py
      ;;
    standard)
      backend/.venv/bin/pytest -q backend/tests
      ;;
    full)
      backend/.venv/bin/pytest -q backend/tests
      ops/run-full-verification
      ;;
  esac
fi
printf '    phase=tests duration_seconds=%s\n' "$((SECONDS - phase_started))"

git_sha="$(git rev-parse --short=12 HEAD 2>/dev/null || printf 'no-git')"
dirty="false"
if ! git diff --quiet --ignore-submodules -- || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  dirty="true"
fi
[[ "${dirty}" == false || "${WAREHOUSE_ALLOW_DIRTY_DEPLOY:-0}" == 1 ]] \
  || fail "refusing to deploy a dirty checkout"
release_id="$(date -u +%Y%m%dT%H%M%SZ)-${git_sha}-${TARGET}-${MODE}"
package="${work_dir}/${release_id}.tar.gz"
checksum_file="${package}.sha256"

mkdir -p "${stage_dir}"
rsync -a \
  --exclude-from "${ROOT}/ops/deploy.exclude" \
  "${ROOT}/backend" \
  "${ROOT}/browser-runtime" \
  "${ROOT}/frontend" \
  "${ROOT}/infra" \
  "${ROOT}/scripts" \
  "${ROOT}/ops" \
  "${ROOT}/docs" \
  "${ROOT}/.dockerignore" \
  "${ROOT}/compose.production.yaml" \
  "${ROOT}/README.md" \
  "${stage_dir}/"

mkdir -p "${stage_dir}/.warehouse-release"
(
  cd "${stage_dir}"
  find . -type f ! -path './.warehouse-release/*' -print | LC_ALL=C sort |
    while IFS= read -r file; do shasum -a 256 "${file}"; done
) > "${stage_dir}/.warehouse-release/files.sha256"

require_file "${ALEMBIC}"
alembic_head="$(cd backend && "${ALEMBIC}" heads | awk 'NR==1 {print $1}')"
[[ -n "${alembic_head}" ]] || fail "Alembic did not report a migration head"

cat > "${stage_dir}/.warehouse-release/manifest.env" <<EOF
release_id=${release_id}
mode=${MODE}
local_validation=${LOCAL_VALIDATION}
install_mode=${INSTALL_MODE}
planned_mode=${PLAN_MODE}
plan_risk=${PLAN_RISK}
plan_changed_count=${PLAN_CHANGED_COUNT}
plan_source=${PLAN_SOURCE}
git_sha=${git_sha}
dirty=${dirty}
built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
alembic_head=${alembic_head}
frontend_bundle_sha256=$(shasum -a 256 frontend/v2/dist/app.bundle.js | awk '{print $1}')
EOF

COPYFILE_DISABLE=1 tar -C "${stage_dir}" -czf "${package}" .
package_hash="$(shasum -a 256 "${package}" | awk '{print $1}')"
printf '%s  %s\n' "${package_hash}" "$(basename "${package}")" > "${checksum_file}"

printf '==> upload immutable release %s\n' "${release_id}"
if [[ "${TRANSPORT}" == local ]]; then
  if [[ "${PREPARE_INCOMING}" == 1 ]]; then
    mkdir -p "${REMOTE_INCOMING}"
  fi
  install -m 0600 "${package}" "${REMOTE_INCOMING}/$(basename "${package}")"
  install -m 0600 "${checksum_file}" "${REMOTE_INCOMING}/$(basename "${checksum_file}")"
else
  if [[ "${PREPARE_INCOMING}" == 1 ]]; then
    printf -v remote_incoming_quoted '%q' "${REMOTE_INCOMING}"
    remote "mkdir -p ${remote_incoming_quoted}"
  fi
  scp_options=("${ssh_options[@]}")
  if [[ "${SCP_LEGACY}" == 1 ]]; then
    scp_options=(-O "${scp_options[@]}")
  fi
  scp "${scp_options[@]}" "${package}" "${checksum_file}" \
    "${USER}@${HOST}:${REMOTE_INCOMING}/"
fi

if [[ -n "${RELEASE_ID_FILE}" ]]; then
  [[ "${RELEASE_ID_FILE}" == /* ]] \
    || fail "WAREHOUSE_DEPLOY_RELEASE_ID_FILE must be an absolute path"
  printf '%s\n' "${release_id}" > "${RELEASE_ID_FILE}"
fi

printf '==> server %s and verification\n' "${DEPLOY_ACTION}"
manager_remote "${DEPLOY_ACTION}" "${release_id}" "${INSTALL_MODE}"
if [[ "${DEPLOY_ACTION}" == prepare ]]; then
  printf '==> prepared %s on %s in %ss\n' \
    "${release_id}" "${TARGET}" "$((SECONDS - deploy_started))"
else
  printf '==> deployed %s to %s in %ss\n' \
    "${release_id}" "${TARGET}" "$((SECONDS - deploy_started))"
fi
