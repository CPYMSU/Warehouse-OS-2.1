#!/usr/bin/env python3
"""Report the unique Alembic head without importing project dependencies."""

from __future__ import annotations

import ast
import sys
from pathlib import Path


def assigned(module: ast.Module, name: str) -> object:
    for statement in module.body:
        if isinstance(statement, ast.Assign):
            for target in statement.targets:
                if isinstance(target, ast.Name) and target.id == name:
                    return ast.literal_eval(statement.value)
        if (
            isinstance(statement, ast.AnnAssign)
            and isinstance(statement.target, ast.Name)
            and statement.target.id == name
        ):
            return ast.literal_eval(statement.value)
    raise RuntimeError(f"missing {name}")


def main() -> int:
    if sys.argv[1:] != ["heads"]:
        raise SystemExit("usage: ops/alembic-head heads")

    versions = Path("alembic/versions")
    revisions: set[str] = set()
    parents: set[str] = set()
    for migration in versions.glob("*.py"):
        module = ast.parse(
            migration.read_text(encoding="utf-8"), filename=str(migration)
        )
        revision = assigned(module, "revision")
        down_revision = assigned(module, "down_revision")
        if not isinstance(revision, str):
            raise TypeError(f"invalid revision in {migration}")
        revisions.add(revision)
        if isinstance(down_revision, str):
            parents.add(down_revision)
        elif isinstance(down_revision, (tuple, list)):
            parents.update(str(parent) for parent in down_revision)

    heads = sorted(revisions - parents)
    if len(heads) != 1:
        raise SystemExit(f"expected exactly one migration head, found: {heads}")
    print(f"{heads[0]} (head)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
