#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="${HOME}/.orbstack/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

DEPLOY_ROOT="${WAREHOUSE_MAC_DEPLOY_ROOT:-${HOME}/Server/bonfirework}"
INCOMING="${DEPLOY_ROOT}/incoming"
RELEASES="${DEPLOY_ROOT}/releases"
CURRENT="${DEPLOY_ROOT}/current"
STATE="${DEPLOY_ROOT}/state"
SHARED="${DEPLOY_ROOT}/shared"
ENV_FILE="${SHARED}/orbstack.env"
LOG_DIR="${SHARED}/logs"
LOG_FILE="${LOG_DIR}/deployments.jsonl"
COMPOSE_FILE="${DEPLOY_ROOT}/compose.macos.yaml"
OVERRIDE_FILE="${STATE}/compose.release.yaml"
SHIELD_OVERRIDE="${STATE}/compose.shield.yaml"
PREVIOUS_OVERRIDE="${STATE}/compose.previous.yaml"
ACTIVE_MANIFEST="${STATE}/active-files.sha256"
LOCK_DIR="${STATE}/deploy.lock"
DOCKER="${WAREHOUSE_DOCKER_BIN:-${HOME}/.orbstack/bin/docker}"
CLUSTER_VERIFY="${WAREHOUSE_CLUSTER_VERIFY:-${DEPLOY_ROOT}/actions/cluster/verify-cluster}"
MIGRATION_ROOT="${SHARED}/database-migrations"
MIGRATION_BACKUP_ROOT="${SHARED}/backups/database-migrations"
MIGRATION_DEFER="${WAREHOUSE_DATABASE_MIGRATION_DEFER:-0}"
MIGRATION_WAIT_SECONDS="${WAREHOUSE_DATABASE_MIGRATION_WAIT_SECONDS:-900}"

fail() {
  printf 'warehouse-deploy-macos: %s\n' "$*" >&2
  exit 1
}

require_file() {
  [[ -f "$1" ]] || fail "required file not found: $1"
}

require_runtime() {
  require_file "${COMPOSE_FILE}"
  [[ -x "${DOCKER}" ]] || fail "OrbStack Docker CLI is unavailable: ${DOCKER}"
  "${DOCKER}" info >/dev/null 2>&1 || fail "OrbStack Docker engine is unavailable"
}

valid_release_id() {
  [[ "$1" =~ ^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]{1,80}$ ]]
}

current_release_path() {
  [[ -L "${CURRENT}" ]] || fail "current release symlink is missing"
  local resolved
  resolved="$(readlink "${CURRENT}")"
  [[ "${resolved}" == "${RELEASES}/"* ]] || fail "current release is outside the release root"
  printf '%s\n' "${resolved}"
}

manifest_value() {
  local file="$1" key="$2"
  awk -F= -v wanted="${key}" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "${file}"
}

write_actual_manifest() {
  local release_dir="$1" target="$2" temporary
  [[ -d "${release_dir}" ]] || fail "release directory is missing: ${release_dir}"
  temporary="${target}.tmp.$$"
  (
    cd "${release_dir}"
    find \
      ./backend ./browser-runtime ./frontend ./infra ./scripts ./ops ./docs \
      ./.dockerignore ./compose.production.yaml ./README.md \
      \( -type d \( \
        -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache -o \
        -name .mypy_cache -o -name .venv -o -name node_modules -o \
        -name postgres-data -o -name warehouse_os_api.egg-info \
      \) -prune \) -o \
      \( -type f \
        ! -name .DS_Store ! -name '*.pyc' ! -name '*.pyo' ! -name '*.log' \
        ! -name '*.rtf' ! -name '*.dump' ! -name '*.dump.sha256' \
        ! -name '* 2.*' ! -name .env ! -name '.env.*' \
        ! -name frontend-api-contract-report.json \
        ! -name 'Terminal Saved Output.txt' ! -name 'GITHUB KEY.txt' \
        ! -name 'Vultr Key.rtf' ! -name 'Password.rtf' \
        ! -path './backend/var/*' ! -path './frontend/v2/var/*' -print \
      \) | LC_ALL=C sort |
      while IFS= read -r file; do shasum -a 256 "${file}"; done
  ) > "${temporary}"
  mv -f "${temporary}" "${target}"
}

log_event() {
  local action="$1" status="$2" release="${3:-}" detail="${4:-}"
  mkdir -p "${LOG_DIR}"
  printf '{"time":"%s","action":"%s","status":"%s","release":"%s","detail":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${action}" "${status}" \
    "${release//\"/}" "${detail//\"/}" >> "${LOG_FILE}"
}

verify_release_manifest() {
  local release_dir="$1" manifest="$1/.warehouse-release/files.sha256"
  local line_count unique_count actual_manifest
  require_file "${manifest}"
  if LC_ALL=C grep -Evq '^[a-f0-9]{64}  \./[^[:cntrl:]]+$' "${manifest}"; then
    fail "release file manifest contains a malformed checksum line"
  fi
  if awk '{print $2}' "${manifest}" | grep -Eq '(^|/)\.\.(/|$)'; then
    fail "release file manifest contains an unsafe path"
  fi
  line_count="$(wc -l < "${manifest}" | tr -d ' ')"
  unique_count="$(awk '{print $2}' "${manifest}" | LC_ALL=C sort -u | wc -l | tr -d ' ')"
  [[ "${line_count}" =~ ^[0-9]+$ && "${line_count}" -gt 0 && \
      "${line_count}" == "${unique_count}" ]] \
    || fail "release file manifest contains duplicate or empty entries"
  (
    cd "${release_dir}"
    shasum -a 256 -c .warehouse-release/files.sha256 >/dev/null
  ) || fail "release file manifest verification failed"
  actual_manifest="$(mktemp "${TMPDIR:-/tmp}/warehouse-release-manifest.XXXXXX")"
  write_actual_manifest "${release_dir}" "${actual_manifest}"
  if ! cmp -s "${manifest}" "${actual_manifest}"; then
    rm -f "${actual_manifest}"
    fail "release file manifest does not describe the exact packaged tree"
  fi
  rm -f "${actual_manifest}"
}

[[ "${MIGRATION_DEFER}" =~ ^[01]$ ]] \
  || fail "WAREHOUSE_DATABASE_MIGRATION_DEFER must be 0 or 1"
[[ "${MIGRATION_WAIT_SECONDS}" =~ ^[1-9][0-9]{1,3}$ ]] \
  || fail "WAREHOUSE_DATABASE_MIGRATION_WAIT_SECONDS must be 10..9999"

migration_job_dir() {
  printf '%s/%s\n' "${MIGRATION_ROOT}" "$1"
}

migration_json_value() {
  local path="$1" key="$2"
  [[ -f "${path}" ]] || return 1
  python3 -c \
    'import json,sys; value=json.load(open(sys.argv[1],encoding="utf-8")).get(sys.argv[2]); print(value if value is not None else "")' \
    "${path}" "${key}"
}

prepare_database_migration_request() {
  local release="$1" git_sha="$2" target_revision="$3" job_dir request temporary
  job_dir="$(migration_job_dir "${release}")"
  request="${job_dir}/request.json"
  mkdir -p "${job_dir}" "${MIGRATION_BACKUP_ROOT}"
  chmod 0700 "${MIGRATION_ROOT}" "${job_dir}" "${MIGRATION_BACKUP_ROOT}"
  temporary="${request}.tmp.$$"
  printf '{"schema":"warehouse.database-migration-request.v1","release_id":"%s","git_sha":"%s","target_revision":"%s","node_role":"primary","requested_at":"%s"}\n' \
    "${release}" "${git_sha}" "${target_revision}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "${temporary}"
  chmod 0600 "${temporary}"
  mv -f "${temporary}" "${request}"
}

start_database_migration() {
  local release="$1" image="$2" job_dir request status suffix container state
  job_dir="$(migration_job_dir "${release}")"
  request="${job_dir}/request.json"
  status="${job_dir}/status.json"
  require_file "${request}"
  require_file "${ENV_FILE}"
  state="$(migration_json_value "${status}" status 2>/dev/null || true)"
  [[ "${state}" != succeeded ]] || return 0
  suffix="$(printf '%s' "${release}" | shasum -a 256 | awk '{print substr($1,1,16)}')"
  container="bonfirework-db-migration-${suffix}"
  if [[ "$(container_value "${container}" '{{.State.Running}}')" == true ]]; then
    return 0
  fi
  "${DOCKER}" rm -f "${container}" >/dev/null 2>&1 || true
  "${DOCKER}" run -d \
    --name "${container}" \
    --network bonfirework-runtime \
    --env-file "${ENV_FILE}" \
    -e WAREHOUSE_NODE_ROLE=primary \
    --label org.bonfirework.role=database-migration-controller \
    --label "org.bonfirework.release=${release}" \
    -v "${job_dir}:/migration" \
    -v "${MIGRATION_BACKUP_ROOT}:/backups" \
    --read-only \
    --tmpfs /tmp:size=64m,mode=1777 \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --pids-limit 96 \
    --memory 512m \
    --cpus 0.5 \
    "${image}" \
    python -m app.database_migration_controller \
      --request /migration/request.json \
      --status /migration/status.json \
      --backup-dir /backups >/dev/null
  log_event database_migration queued "${release}" "controller=${container}"
}

wait_database_migration() {
  local release="$1" job_dir status attempt state error
  job_dir="$(migration_job_dir "${release}")"
  status="${job_dir}/status.json"
  for attempt in $(seq 1 "${MIGRATION_WAIT_SECONDS}"); do
    state="$(migration_json_value "${status}" status 2>/dev/null || true)"
    case "${state}" in
      succeeded)
        printf 'database_migration=%s release=%s\n' "${state}" "${release}"
        return 0
        ;;
      failed)
        error="$(migration_json_value "${status}" error 2>/dev/null || printf unknown)"
        printf 'database migration failed: %s\n' "${error}" >&2
        return 1
        ;;
      planning|backing_up|migrating|verifying|"") ;;
      *) fail "database migration controller returned invalid state: ${state}" ;;
    esac
    sleep 1
  done
  fail "database migration controller timed out for ${release}"
}

database_migration_gate() {
  local release="$1" required="$2" target_revision="$3" status state observed
  [[ "${required}" == 1 ]] || return 0
  status="$(migration_job_dir "${release}")/status.json"
  state="$(migration_json_value "${status}" status 2>/dev/null || true)"
  observed="$(migration_json_value "${status}" target_revision 2>/dev/null || true)"
  [[ "${state}" == succeeded && "${observed}" == "${target_revision}" ]] \
    || fail "database migration is not ready for ${release}: ${state:-missing}"
}

load_prepared_migration() {
  local release="$1" prepared_state="${STATE}/prepared-${release}.env"
  valid_release_id "${release}" || fail "invalid release id"
  require_file "${prepared_state}"
  # shellcheck disable=SC1090
  . "${prepared_state}"
  [[ "${PREPARED_RELEASE:-}" == "${release}" ]] \
    || fail "prepared release identity mismatch"
  [[ "${PREPARED_PLAN_MIGRATION:-}" =~ ^[01]$ ]] \
    || fail "prepared database migration plan is invalid"
}

start_prepared_migration() {
  local release="$1"
  load_prepared_migration "${release}"
  if [[ "${PREPARED_PLAN_MIGRATION}" == 0 ]]; then
    printf 'release=%s database_migration=not_required\n' "${release}"
    return 0
  fi
  start_database_migration "${release}" "${PREPARED_API_IMAGE}"
  printf 'release=%s database_migration=queued\n' "${release}"
}

show_prepared_migration() {
  local release="$1" status state target error
  load_prepared_migration "${release}"
  if [[ "${PREPARED_PLAN_MIGRATION}" == 0 ]]; then
    printf 'release=%s database_migration=not_required target=%s\n' \
      "${release}" "${PREPARED_ALEMBIC_HEAD}"
    return 0
  fi
  status="$(migration_job_dir "${release}")/status.json"
  state="$(migration_json_value "${status}" status 2>/dev/null || printf deferred)"
  target="$(migration_json_value "${status}" target_revision 2>/dev/null || true)"
  printf 'release=%s database_migration=%s target=%s\n' \
    "${release}" "${state}" "${target:-${PREPARED_ALEMBIC_HEAD}}"
  if [[ "${state}" == failed ]]; then
    error="$(migration_json_value "${status}" error 2>/dev/null || printf unknown)"
    printf 'error=%s\n' "${error}"
    return 1
  fi
}

wait_prepared_migration() {
  local release="$1"
  load_prepared_migration "${release}"
  [[ "${PREPARED_PLAN_MIGRATION}" == 1 ]] || {
    printf 'release=%s database_migration=not_required\n' "${release}"
    return 0
  }
  wait_database_migration "${release}"
}

require_arm64_image() {
  local image="$1" architecture
  architecture="$("${DOCKER}" image inspect "${image}" --format '{{.Architecture}}')"
  [[ "${architecture}" == arm64 ]] \
    || fail "candidate image is ${architecture}, expected native arm64: ${image}"
}

validate_primary_api() {
  local readiness openapi
  readiness="$(/usr/bin/curl -fsS --max-time 10 \
    http://127.0.0.1:8081/api/system/readiness)" || return 1
  grep -Fq '"node_id":"mac-primary"' <<<"${readiness}" || return 1
  grep -Fq '"node_role":"primary"' <<<"${readiness}" || return 1
  openapi="$(mktemp "${STATE}/openapi.XXXXXX")"
  if ! /usr/bin/curl -fsS --max-time 20 \
      http://127.0.0.1:8081/openapi.json > "${openapi}" \
    || ! grep -Fq '"/api/lighthouse/devices"' "${openapi}" \
    || ! grep -Fq '"/api/lighthouse/pairing-challenges"' "${openapi}"; then
    rm -f "${openapi}"
    return 1
  fi
  rm -f "${openapi}"
}

acquire_lock() {
  mkdir -p "${STATE}"
  mkdir "${LOCK_DIR}" 2>/dev/null || fail "another deployment is already running"
  trap 'rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT
}

container_value() {
  local container="$1" template="$2"
  "${DOCKER}" inspect "${container}" --format "${template}" 2>/dev/null || printf 'missing'
}

wait_healthy() {
  local container="$1" attempt status
  for attempt in $(seq 1 60); do
    status="$(container_value "${container}" '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')"
    [[ "${status}" == healthy ]] && return 0
    [[ "${status}" == exited || "${status}" == dead || "${status}" == missing ]] && return 1
    sleep 3
  done
  return 1
}

compose() {
  local args=(-f "${COMPOSE_FILE}")
  [[ ! -f "${OVERRIDE_FILE}" ]] || args+=(-f "${OVERRIDE_FILE}")
  [[ ! -f "${SHIELD_OVERRIDE}" ]] || args+=(-f "${SHIELD_OVERRIDE}")
  "${DOCKER}" compose "${args[@]}" "$@"
}

reject_runtime_code_overrides() {
  local rendered bad
  rendered="$(mktemp "${TMPDIR:-/tmp}/warehouse-compose.XXXXXX")"
  chmod 0600 "${rendered}"
  if ! compose config --format json > "${rendered}"; then
    rm -f "${rendered}"
    fail "Mac Compose configuration is invalid"
  fi
  bad="$(python3 -c '
import json, sys

document = json.load(open(sys.argv[1], encoding="utf-8"))
roots = ("/service/app", "/service/alembic", "/frontend/v2")
observed = []
for service, config in (document.get("services") or {}).items():
    for volume in config.get("volumes") or []:
        if not isinstance(volume, dict):
            continue
        target = str(volume.get("target") or "").rstrip("/")
        if any(target == root or target.startswith(root + "/") for root in roots):
            observed.append(f"{service}:{target}")
print(",".join(sorted(observed)))
' "${rendered}")"
  rm -f "${rendered}"
  [[ -z "${bad}" ]] \
    || fail "mutable runtime code override is forbidden: ${bad}"
}

install_shield_agent() {
  local installer="${CURRENT}/ops/macos/install-shield-agent"
  [[ -x "${installer}" ]] || return 0
  "${installer}" >/dev/null
  [[ -S "${SHARED}/shield/agent.sock" ]] \
    || fail "Mac SHIELD agent socket is unavailable after installation"
}

install_control_actions() {
  local source="${CURRENT}/ops/macos/warehouse-deploy-macos"
  local gate_source="${CURRENT}/ops/macos/warehouse-deploy-ssh-gate"
  [[ -f "${source}" ]] || return 0
  [[ -f "${gate_source}" ]] || fail "candidate Mac deployment SSH gate is missing"
  bash -n "${source}" || fail "candidate Mac deployment action failed syntax validation"
  bash -n "${gate_source}" || fail "candidate Mac deployment SSH gate failed syntax validation"
  install -m 0750 "${source}" "${DEPLOY_ROOT}/actions/warehouse-deploy-macos"
  install -m 0750 "${gate_source}" "${DEPLOY_ROOT}/actions/warehouse-deploy-ssh-gate"
  install -m 0750 "${source}" "${DEPLOY_ROOT}/bin/warehouse-deploy"
}

install_operator_routes() {
  local fast_source="${CURRENT}/ops/fast-deploy"
  local optimizer_source="${CURRENT}/ops/macos/warehouse-clash-route-optimizer"
  local plist_source="${CURRENT}/ops/macos/org.bonfirework.clash-route-optimizer.plist"
  local optimizer_target="${DEPLOY_ROOT}/actions/warehouse-clash-route-optimizer"
  local plist_target="${HOME}/Library/LaunchAgents/org.bonfirework.clash-route-optimizer.plist"
  local changed=0 uid
  if [[ -x "${fast_source}" ]]; then
    ln -sfn "${CURRENT}/ops/fast-deploy" "${DEPLOY_ROOT}/bin/warehouse-fast-deploy"
  fi
  [[ -f "${optimizer_source}" && -f "${plist_source}" ]] || return 0
  cmp -s "${optimizer_source}" "${optimizer_target}" || changed=1
  cmp -s "${plist_source}" "${plist_target}" || changed=1
  install -m 0755 "${optimizer_source}" "${optimizer_target}"
  mkdir -p "${HOME}/Library/LaunchAgents"
  install -m 0644 "${plist_source}" "${plist_target}"
  /usr/bin/plutil -lint "${plist_target}" >/dev/null \
    || fail "Clash route optimizer LaunchAgent is invalid"
  [[ "${changed}" == 1 ]] || return 0
  uid="$(id -u)"
  if /bin/launchctl print \
      "gui/${uid}/org.bonfirework.clash-route-optimizer" >/dev/null 2>&1; then
    /bin/launchctl bootout "gui/${uid}" "${plist_target}" >/dev/null
  fi
  /bin/launchctl bootstrap "gui/${uid}" "${plist_target}"
  /bin/launchctl enable "gui/${uid}/org.bonfirework.clash-route-optimizer"
  /bin/launchctl kickstart "gui/${uid}/org.bonfirework.clash-route-optimizer"
}

show_status() {
  require_runtime
  local release_path release readiness api_image api_health controller_health
  release_path="$(current_release_path)"
  release="$(basename "${release_path}")"
  api_image="$(container_value bonfirework-mac-api '{{.Config.Image}}')"
  api_health="$(container_value bonfirework-mac-api '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')"
  controller_health="$(container_value bonfirework-mac-runtime-controller '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')"
  readiness="$(/usr/bin/curl -fsS --max-time 5 http://127.0.0.1:8081/api/system/readiness 2>/dev/null || printf '{}')"
  printf 'node=mac-primary\nplatform=linux/arm64\ncurrent=%s\nrelease=%s\napi_image=%s\napi_health=%s\nruntime_controller_health=%s\nreadiness=%s\n' \
    "${release_path}" "${release}" "${api_image}" "${api_health}" \
    "${controller_health}" "${readiness}"
  printf 'shield_agent=%s\n' "$([[ -S "${SHARED}/shield/agent.sock" ]] && printf ready || printf offline)"
  printf 'fast_deploy=%s\n' "${DEPLOY_ROOT}/bin/warehouse-fast-deploy"
  printf 'deployment_route=GitHub_to_Mac_runner_to_coordinated_Mac_Vultr\n'
}

bootstrap() {
  require_runtime
  reject_runtime_code_overrides
  acquire_lock
  mkdir -p "${INCOMING}" "${RELEASES}" "${STATE}" "${LOG_DIR}"
  chmod 0700 "${INCOMING}" "${STATE}"
  local release_path
  release_path="$(current_release_path)"
  write_actual_manifest "${release_path}" "${ACTIVE_MANIFEST}"
  install_shield_agent
  install_operator_routes
  printf '%s\n' "$(basename "${release_path}")" > "${STATE}/current-release"
  log_event bootstrap succeeded "$(basename "${release_path}")" "active manifest captured without restart"
  show_status
}

show_manifest() {
  require_file "${ACTIVE_MANIFEST}"
  cat "${ACTIVE_MANIFEST}"
}

show_history() {
  [[ -f "${LOG_FILE}" ]] || return 0
  tail -n 50 "${LOG_FILE}"
}

show_cluster_status() {
  [[ -x "${CLUSTER_VERIFY}" ]] || fail "cluster verification action is unavailable"
  "${CLUSTER_VERIFY}" "$@"
}

show_plan() {
  local candidate_manifest="$1" release_path planner
  require_file "${ACTIVE_MANIFEST}"
  require_file "${candidate_manifest}"
  release_path="$(current_release_path)"
  planner="${release_path}/ops/deploy-plan"
  [[ -x "${planner}" ]] || fail "active deploy planner is unavailable"
  "${planner}" \
    --base-manifest "${ACTIVE_MANIFEST}" \
    --candidate-manifest "${candidate_manifest}" \
    --format json
}

write_override() {
  local release="$1" git_sha="$2" alembic_head="$3" api_image="$4"
  local browser_image="${5:-}" research_image="${6:-}"
  local temporary="${OVERRIDE_FILE}.tmp.$$"
  {
    printf 'services:\n'
    printf '  api:\n    image: %s\n' "${api_image}"
    printf '    environment:\n'
    printf '      WAREHOUSE_NODE_ID: mac-primary\n'
    printf '      WAREHOUSE_NODE_ROLE: primary\n'
    printf '      WAREHOUSE_NODE_PLATFORM: linux/arm64\n'
    printf '      WAREHOUSE_CLUSTER_PEERS: vultr-standby\n'
    printf '      WAREHOUSE_RELEASE_ID: %s\n' "${release}"
    printf '      WAREHOUSE_GIT_SHA: %s\n' "${git_sha}"
    printf '      WAREHOUSE_ALEMBIC_HEAD: "%s"\n' "${alembic_head}"
    printf '      WAREHOUSE_MIGRATION_DATABASE_URL: ""\n'
    printf '      WAREHOUSE_MIGRATOR_DB_PASSWORD: ""\n'
    printf '  runtime-controller:\n    image: %s\n' "${api_image}"
    printf '    environment:\n'
    printf '      WAREHOUSE_MIGRATION_DATABASE_URL: ""\n'
    printf '      WAREHOUSE_MIGRATOR_DB_PASSWORD: ""\n'
    if [[ -n "${browser_image}" ]]; then
      printf '  browser-runtime:\n    image: %s\n' "${browser_image}"
      printf '    environment:\n'
      printf '      WAREHOUSE_MIGRATION_DATABASE_URL: ""\n'
      printf '      WAREHOUSE_MIGRATOR_DB_PASSWORD: ""\n'
    fi
    if [[ -n "${research_image}" ]]; then
      printf '  research-executor:\n    image: %s\n' "${research_image}"
    fi
  } > "${temporary}"
  mv -f "${temporary}" "${OVERRIDE_FILE}"
}

restore_previous() {
  local previous_release="$1"
  ln -sfn "${previous_release}" "${CURRENT}"
  if [[ -f "${PREVIOUS_OVERRIDE}" ]]; then
    cp "${PREVIOUS_OVERRIDE}" "${OVERRIDE_FILE}"
  else
    rm -f "${OVERRIDE_FILE}"
  fi
  # Restore the host bridge and its Compose contract together with the images.
  # A failed host-agent rollout must not leave the previous API attached to an
  # incompatible transport.
  install_operator_routes || true
  install_shield_agent || true
  compose up -d --no-build --no-deps api runtime-controller >/dev/null
  wait_healthy bonfirework-mac-api || true
  wait_healthy bonfirework-mac-runtime-controller || true
}

prepare_release() {
  local release="$1" requested_mode="$2"
  valid_release_id "${release}" || fail "invalid release id"
  [[ "${requested_mode}" =~ ^(smart|quick|standard|full)$ ]] || fail "invalid deployment mode"
  require_runtime
  reject_runtime_code_overrides
  acquire_lock

  local archive="${INCOMING}/${release}.tar.gz"
  local checksum="${archive}.sha256"
  local staging="${RELEASES}/.${release}.staging"
  local release_dir="${RELEASES}/${release}"
  local expected actual
  require_file "${archive}"
  require_file "${checksum}"
  [[ ! -e "${release_dir}" && ! -e "${staging}" ]] || fail "release already exists"
  expected="$(awk 'NR == 1 {print $1}' "${checksum}")"
  actual="$(shasum -a 256 "${archive}" | awk '{print $1}')"
  [[ "${expected}" =~ ^[a-f0-9]{64}$ && "${actual}" == "${expected}" ]] \
    || fail "release checksum mismatch"
  if tar -tzf "${archive}" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    fail "release archive contains an unsafe path"
  fi

  mkdir -p "${staging}"
  trap 'rm -rf "${staging}"; rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT
  tar --no-same-owner -xzf "${archive}" -C "${staging}"
  [[ -z "$(find "${staging}" -type l -print -quit)" ]] || fail "release archive contains a symbolic link"
  verify_release_manifest "${staging}"

  local plan_output plan_mode plan_api plan_browser plan_research plan_control plan_deploy plan_migration
  require_file "${ACTIVE_MANIFEST}"
  [[ -x "${staging}/ops/deploy-plan" ]] || fail "candidate deploy planner is missing"
  plan_output="$("${staging}/ops/deploy-plan" \
    --base-manifest "${ACTIVE_MANIFEST}" \
    --candidate-manifest "${staging}/.warehouse-release/files.sha256" \
    --format shell)"
  eval "${plan_output}"
  plan_mode="${PLAN_MODE:-full}"
  plan_api="${PLAN_API:-1}"
  plan_browser="${PLAN_BROWSER:-0}"
  plan_research="${PLAN_RESEARCH_EXECUTOR:-0}"
  plan_control="${PLAN_CONTROL_PLANE:-0}"
  plan_migration="${PLAN_MIGRATION:-0}"
  plan_deploy="${PLAN_DEPLOY_REQUIRED:-1}"
  [[ "${plan_deploy}" == 1 ]] || fail "candidate contains no runtime-impacting changes"
  if [[ "${requested_mode}" == smart ]]; then
    requested_mode="${plan_mode}"
  fi
  [[ "${plan_api}" == 1 || "${plan_browser}" == 1 || "${plan_research}" == 1 \
      || "${plan_control}" == 1 ]] \
    || fail "candidate does not affect a Mac runtime component"

  local metadata="${staging}/.warehouse-release/manifest.env"
  require_file "${metadata}"
  local git_sha alembic_head api_image browser_image research_image
  git_sha="$(manifest_value "${metadata}" git_sha)"
  alembic_head="$(manifest_value "${metadata}" alembic_head)"
  [[ "${git_sha}" =~ ^[A-Za-z0-9._-]{3,80}$ ]] || fail "candidate git SHA is invalid"
  [[ "${alembic_head}" =~ ^[A-Za-z0-9._-]{3,120}$ ]] || fail "candidate Alembic head is invalid"

  api_image="bonfirework-api-mac:${release}"
  browser_image="$(container_value bonfirework-mac-browser '{{.Config.Image}}')"
  [[ "${browser_image}" != missing ]] || browser_image=""
  research_image="$(container_value bonfirework-mac-research '{{.Config.Image}}')"
  [[ "${research_image}" != missing ]] || research_image=""
  if [[ "${plan_api}" == 1 ]]; then
    "${DOCKER}" build --file "${staging}/backend/Dockerfile" --tag "${api_image}" "${staging}" >/dev/null
    require_arm64_image "${api_image}"
  else
    api_image="$(container_value bonfirework-mac-api '{{.Config.Image}}')"
  fi
  if [[ "${plan_research}" == 1 ]]; then
    research_image="bonfirework-research-mac:${release}"
    "${DOCKER}" build --file "${staging}/backend/Dockerfile.research-executor" \
      --tag "${research_image}" "${staging}" >/dev/null
    require_arm64_image "${research_image}"
  fi
  if [[ "${plan_browser}" == 1 ]]; then
    browser_image="bonfirework-browser-mac:${release}"
    "${DOCKER}" build --file "${staging}/browser-runtime/Dockerfile" \
      --tag "${browser_image}" "${staging}" >/dev/null
    require_arm64_image "${browser_image}"
  fi

  mv "${staging}" "${release_dir}"
  trap 'rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT
  if [[ "${plan_migration}" == 1 ]]; then
    prepare_database_migration_request "${release}" "${git_sha}" "${alembic_head}"
    if [[ "${MIGRATION_DEFER}" == 0 ]]; then
      start_database_migration "${release}" "${api_image}"
      wait_database_migration "${release}"
    fi
  fi
  local prepared_state="${STATE}/prepared-${release}.env"
  local prepared_temporary="${prepared_state}.tmp.$$"
  {
    printf 'PREPARED_RELEASE=%q\n' "${release}"
    printf 'PREPARED_MODE=%q\n' "${requested_mode}"
    printf 'PREPARED_GIT_SHA=%q\n' "${git_sha}"
    printf 'PREPARED_ALEMBIC_HEAD=%q\n' "${alembic_head}"
    printf 'PREPARED_API_IMAGE=%q\n' "${api_image}"
    printf 'PREPARED_BROWSER_IMAGE=%q\n' "${browser_image}"
    printf 'PREPARED_RESEARCH_IMAGE=%q\n' "${research_image}"
    printf 'PREPARED_PLAN_API=%q\n' "${plan_api}"
    printf 'PREPARED_PLAN_BROWSER=%q\n' "${plan_browser}"
    printf 'PREPARED_PLAN_RESEARCH=%q\n' "${plan_research}"
    printf 'PREPARED_PLAN_MIGRATION=%q\n' "${plan_migration}"
    printf 'PREPARED_PLAN_RISK=%q\n' "${PLAN_RISK:-unknown}"
    printf 'PREPARED_AT=%q\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "${prepared_temporary}"
  chmod 0600 "${prepared_temporary}"
  mv -f "${prepared_temporary}" "${prepared_state}"
  rmdir "${LOCK_DIR}"
  trap - EXIT
  log_event prepare succeeded "${release}" "mode=${requested_mode};risk=${PLAN_RISK:-unknown}"
  printf 'release=%s git_sha=%s alembic_head=%s status=prepared\n' \
    "${release}" "${git_sha}" "${alembic_head}"
}

prepared_status() {
  local release="$1" prepared_state
  valid_release_id "${release}" || fail "invalid release id"
  prepared_state="${STATE}/prepared-${release}.env"
  require_file "${prepared_state}"
  # shellcheck disable=SC1090
  . "${prepared_state}"
  [[ "${PREPARED_RELEASE:-}" == "${release}" ]] \
    || fail "prepared release identity mismatch"
  "${DOCKER}" image inspect "${PREPARED_API_IMAGE}" >/dev/null 2>&1 \
    || fail "prepared API image is unavailable"
  database_migration_gate "${release}" "${PREPARED_PLAN_MIGRATION:-0}" \
    "${PREPARED_ALEMBIC_HEAD}"
  printf 'release=%s git_sha=%s alembic_head=%s status=prepared\n' \
    "${release}" "${PREPARED_GIT_SHA}" "${PREPARED_ALEMBIC_HEAD}"
}

activate_release() {
  local release="$1" activate_started prepared_state release_dir archive checksum
  local previous_release
  activate_started="${SECONDS}"
  valid_release_id "${release}" || fail "invalid release id"
  require_runtime
  reject_runtime_code_overrides
  acquire_lock
  prepared_state="${STATE}/prepared-${release}.env"
  require_file "${prepared_state}"
  [[ "$(stat -f '%Su:%Lp' "${prepared_state}")" == "$(id -un):600" ]] \
    || fail "prepared release state permissions are unsafe"
  # shellcheck disable=SC1090
  . "${prepared_state}"
  [[ "${PREPARED_RELEASE:-}" == "${release}" ]] \
    || fail "prepared release identity mismatch"
  [[ "${PREPARED_MODE:-}" =~ ^(quick|standard|full)$ ]] \
    || fail "prepared mode is invalid"
  [[ "${PREPARED_GIT_SHA:-}" =~ ^[A-Za-z0-9._-]{3,80}$ ]] \
    || fail "prepared git SHA is invalid"
  [[ "${PREPARED_ALEMBIC_HEAD:-}" =~ ^[A-Za-z0-9._-]{3,120}$ ]] \
    || fail "prepared Alembic head is invalid"
  [[ "${PREPARED_PLAN_API:-}" =~ ^[01]$ \
      && "${PREPARED_PLAN_BROWSER:-}" =~ ^[01]$ \
      && "${PREPARED_PLAN_RESEARCH:-}" =~ ^[01]$ \
      && "${PREPARED_PLAN_MIGRATION:-}" =~ ^[01]$ ]] \
    || fail "prepared impact plan is invalid"
  release_dir="${RELEASES}/${release}"
  archive="${INCOMING}/${release}.tar.gz"
  checksum="${archive}.sha256"
  [[ -d "${release_dir}" ]] || fail "prepared release directory is missing"
  "${DOCKER}" image inspect "${PREPARED_API_IMAGE}" >/dev/null 2>&1 \
    || fail "prepared API image is unavailable"
  database_migration_gate "${release}" "${PREPARED_PLAN_MIGRATION}" \
    "${PREPARED_ALEMBIC_HEAD}"

  previous_release="$(current_release_path)"
  printf '%s\n' "${previous_release}" > "${STATE}/previous-release"
  if [[ -f "${OVERRIDE_FILE}" ]]; then
    cp "${OVERRIDE_FILE}" "${PREVIOUS_OVERRIDE}"
  else
    rm -f "${PREVIOUS_OVERRIDE}"
  fi

  ln -sfn "${release_dir}" "${CURRENT}"
  write_override "${release}" "${PREPARED_GIT_SHA}" "${PREPARED_ALEMBIC_HEAD}" \
    "${PREPARED_API_IMAGE}" "${PREPARED_BROWSER_IMAGE}" \
    "${PREPARED_RESEARCH_IMAGE}"
  if ! install_operator_routes; then
    restore_previous "${previous_release}"
    log_event deploy rolled_back "${release}" "operator route installation failed"
    fail "candidate fast deployment route failed installation"
  fi
  if ! install_shield_agent; then
    restore_previous "${previous_release}"
    log_event deploy rolled_back "${release}" "shield agent installation failed"
    fail "candidate SHIELD agent failed readiness; previous release restored"
  fi
  compose config >/dev/null || {
    restore_previous "${previous_release}"
    fail "Mac Compose override validation failed"
  }

  # Every release refreshes API metadata even when it reuses the immutable
  # application image, keeping both nodes on one auditable Git baseline.
  compose up -d --no-build --no-deps api >/dev/null
  if ! wait_healthy bonfirework-mac-api; then
    restore_previous "${previous_release}"
    log_event activate rolled_back "${release}" "api health check failed"
    fail "candidate API failed its health check; previous release restored"
  fi
  if ! validate_primary_api; then
    restore_previous "${previous_release}"
    log_event activate rolled_back "${release}" "primary API contract validation failed"
    fail "candidate API failed primary-node contract validation; previous release restored"
  fi
  if [[ "${PREPARED_PLAN_API}" == 1 ]]; then
    compose up -d --no-build --no-deps runtime-controller >/dev/null
    if ! wait_healthy bonfirework-mac-runtime-controller; then
      restore_previous "${previous_release}"
      log_event deploy rolled_back "${release}" "runtime controller health check failed"
      fail "candidate Runtime Controller failed its health check; previous release restored"
    fi
  fi
  if [[ "${PREPARED_PLAN_RESEARCH}" == 1 ]]; then
    compose up -d --no-build --no-deps research-executor >/dev/null
    if ! wait_healthy bonfirework-mac-research; then
      restore_previous "${previous_release}"
      compose up -d --no-build --no-deps research-executor >/dev/null || true
      wait_healthy bonfirework-mac-research || true
      log_event deploy rolled_back "${release}" "research executor health check failed"
      fail "candidate Research Executor failed its health check; previous release restored"
    fi
  fi
  if [[ "${PREPARED_PLAN_BROWSER}" == 1 ]]; then
    compose up -d --no-build --no-deps browser-runtime >/dev/null
    if ! wait_healthy bonfirework-mac-browser; then
      restore_previous "${previous_release}"
      log_event deploy rolled_back "${release}" "browser health check failed"
      fail "candidate browser worker failed its health check; previous release restored"
    fi
  fi

  cp "${release_dir}/.warehouse-release/files.sha256" "${ACTIVE_MANIFEST}"
  printf '%s\n' "${release}" > "${STATE}/current-release"
  rm -f "${archive}" "${checksum}" "${prepared_state}"
  install_control_actions
  log_event activate succeeded "${release}" \
    "mode=${PREPARED_MODE};risk=${PREPARED_PLAN_RISK};duration_seconds=$((SECONDS - activate_started))"
  show_status
}

install_release() {
  prepare_release "$1" "$2"
  activate_release "$1"
}

rollback_release() {
  require_runtime
  acquire_lock
  local previous current
  require_file "${STATE}/previous-release"
  previous="$(tr -d '\r\n' < "${STATE}/previous-release")"
  [[ "${previous}" == "${RELEASES}/"* && -d "${previous}" ]] \
    || fail "previous release is invalid"
  current="$(current_release_path)"
  restore_previous "${previous}"
  write_actual_manifest "${previous}" "${ACTIVE_MANIFEST}"
  printf '%s\n' "$(basename "${previous}")" > "${STATE}/current-release"
  printf '%s\n' "${current}" > "${STATE}/previous-release"
  log_event rollback succeeded "$(basename "${previous}")" "from=$(basename "${current}")"
  show_status
}

case "${1:-}" in
  bootstrap)
    [[ "$#" -eq 1 ]] || fail "bootstrap takes no arguments"
    bootstrap
    ;;
  status)
    [[ "$#" -eq 1 ]] || fail "status takes no arguments"
    show_status
    ;;
  manifest)
    [[ "$#" -eq 1 ]] || fail "manifest takes no arguments"
    show_manifest
    ;;
  history)
    [[ "$#" -eq 1 ]] || fail "history takes no arguments"
    show_history
    ;;
  plan)
    [[ "$#" -eq 2 ]] || fail "usage: warehouse-deploy-macos plan CANDIDATE_MANIFEST"
    show_plan "$2"
    ;;
  cluster-status)
    shift
    show_cluster_status "$@"
    ;;
  prepare)
    [[ "$#" -eq 3 ]] || fail "usage: warehouse-deploy-macos prepare RELEASE MODE"
    prepare_release "$2" "$3"
    ;;
  prepare-deferred)
    [[ "$#" -eq 3 ]] \
      || fail "usage: warehouse-deploy-macos prepare-deferred RELEASE MODE"
    MIGRATION_DEFER=1
    prepare_release "$2" "$3"
    ;;
  prepared-status)
    [[ "$#" -eq 2 ]] || fail "usage: warehouse-deploy-macos prepared-status RELEASE"
    prepared_status "$2"
    ;;
  migration-start)
    [[ "$#" -eq 2 ]] || fail "usage: warehouse-deploy-macos migration-start RELEASE"
    start_prepared_migration "$2"
    ;;
  migration-status)
    [[ "$#" -eq 2 ]] || fail "usage: warehouse-deploy-macos migration-status RELEASE"
    show_prepared_migration "$2"
    ;;
  migration-wait)
    [[ "$#" -eq 2 ]] || fail "usage: warehouse-deploy-macos migration-wait RELEASE"
    wait_prepared_migration "$2"
    ;;
  activate)
    [[ "$#" -eq 2 ]] || fail "usage: warehouse-deploy-macos activate RELEASE"
    activate_release "$2"
    ;;
  install)
    [[ "$#" -eq 3 ]] || fail "usage: warehouse-deploy-macos install RELEASE MODE"
    install_release "$2" "$3"
    ;;
  rollback)
    [[ "$#" -eq 1 ]] || fail "rollback takes no arguments"
    rollback_release
    ;;
  *)
    fail "usage: warehouse-deploy-macos bootstrap|status|cluster-status [VERIFY_OPTIONS]|manifest|plan CANDIDATE_MANIFEST|history|prepare RELEASE MODE|prepare-deferred RELEASE MODE|prepared-status RELEASE|migration-start RELEASE|migration-status RELEASE|migration-wait RELEASE|activate RELEASE|install RELEASE MODE|rollback"
    ;;
esac
