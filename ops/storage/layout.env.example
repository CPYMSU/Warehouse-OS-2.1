# Stable application-facing storage root. Keep this name across disk migrations.
WAREHOUSE_STORAGE_ROOT=/Volumes/BonfireworkData

# Source clusters currently active on the Mac mini.
WAREHOUSE_CONTROL_PGDATA=/opt/homebrew/var/postgresql@18
WAREHOUSE_HOSTED_PGDATA=/Users/peiyuan/Server/bonfirework/shared/hosted-databases

# Leave false for AppleRAID. Set true only after verifying an enclosure that
# presents a hardware RAID1 virtual disk and reports both members healthy.
WAREHOUSE_HARDWARE_RAID_APPROVED=false
