#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Rebuild only the disposable Vultr control-plane subscriber from the Mac
# primary.  This is intentionally separate from release activation and never
# runs on the primary or on hosted customer databases.

DEPLOY_ROOT=/opt/warehouse-os
SHARED="${DEPLOY_ROOT}/shared"
ENV_FILE="${SHARED}/.env.production"
CONTROL_CONTAINER=warehouse-os-postgres-1
DATABASE=warehouse_os
SUBSCRIPTION=warehouse_from_mac
ARCHIVE_ROOT=/mnt/warehouse-data/hosted/archive/standby-reseed
STATE_ROOT="${SHARED}/database-reseed"
WAIT_SECONDS="${WAREHOUSE_STANDBY_RESEED_WAIT_SECONDS:-900}"

fail() {
  printf 'warehouse-standby-reseed: %s\n' "$*" >&2
  exit 1
}

[[ "${EUID}" == 0 ]] || fail "root is required"
[[ "${WAREHOUSE_CONFIRM_STANDBY_RESEED:-}" == YES ]] \
  || fail "WAREHOUSE_CONFIRM_STANDBY_RESEED=YES is required"
[[ "${WAIT_SECONDS}" =~ ^[1-9][0-9]{1,3}$ ]] \
  || fail "WAREHOUSE_STANDBY_RESEED_WAIT_SECONDS must be 10..9999"
[[ -f "${ENV_FILE}" ]] || fail "production environment is missing"
docker inspect "${CONTROL_CONTAINER}" >/dev/null 2>&1 \
  || fail "control PostgreSQL container is missing"

set -a
# shellcheck disable=SC1090
. "${ENV_FILE}"
set +a
[[ "${WAREHOUSE_NODE_ROLE:-}" == standby ]] \
  || fail "refusing to reseed a node that is not configured as standby"

control_psql() {
  docker exec "${CONTROL_CONTAINER}" sh -lc \
    'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"' sh "$@"
}

postgres_psql() {
  docker exec "${CONTROL_CONTAINER}" sh -lc \
    'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres "$@"' sh "$@"
}

role_fences="$(control_psql -At -c \
  "select rolname || '=' || coalesce(array_to_string(rolconfig,','),'') from pg_roles where rolname in ('warehouse_os','warehouse_migrator') order by rolname")"
grep -Fq 'warehouse_os=default_transaction_read_only=true' <<<"${role_fences}" \
  || fail "standby application role is not fenced read-only"
grep -Fq 'warehouse_migrator=default_transaction_read_only=true' <<<"${role_fences}" \
  || fail "standby migrator role is not fenced read-only"

subscription_count="$(control_psql -At -c \
  "select count(*) from pg_subscription where subname='${SUBSCRIPTION}'")"
[[ "${subscription_count}" == 1 ]] || fail "expected exactly one control subscription"

conninfo="$(control_psql -At -c \
  "select subconninfo from pg_subscription where subname='${SUBSCRIPTION}'")"
publication="$(control_psql -At -c \
  "select array_to_string(subpublications,',') from pg_subscription where subname='${SUBSCRIPTION}'")"
slot_name="$(control_psql -At -c \
  "select subslotname from pg_subscription where subname='${SUBSCRIPTION}'")"
[[ "${publication}" == warehouse_control_pub ]] \
  || fail "unexpected publisher publication: ${publication}"
[[ "${slot_name}" == vultr_control ]] \
  || fail "unexpected publisher slot: ${slot_name}"

mapfile -d '' -t publisher_fields < <(
  printf '%s' "${conninfo}" | python3 -c '
import shlex, sys

options = {}
for item in shlex.split(sys.stdin.read()):
    key, separator, value = item.partition("=")
    if not separator:
        raise SystemExit("invalid publisher conninfo")
    options[key] = value
for name in (
    "host", "hostaddr", "port", "user", "password", "dbname",
    "sslmode", "connect_timeout",
):
    sys.stdout.write(options.get(name, "") + "\0")
'
)
[[ "${#publisher_fields[@]}" == 8 ]] \
  || fail "publisher conninfo could not be parsed"
export PGHOST="${publisher_fields[0]}"
export PGHOSTADDR="${publisher_fields[1]}"
export PGPORT="${publisher_fields[2]}"
export PGUSER="${publisher_fields[3]}"
export PGPASSWORD="${publisher_fields[4]}"
export PGDATABASE="${publisher_fields[5]}"
export PGSSLMODE="${publisher_fields[6]}"
export PGCONNECT_TIMEOUT="${publisher_fields[7]}"
[[ -n "${PGHOST}${PGHOSTADDR}" && -n "${PGUSER}" \
    && -n "${PGPASSWORD}" && -n "${PGDATABASE}" ]] \
  || fail "publisher conninfo is incomplete"

publisher_environment=(-e PGUSER -e PGPASSWORD -e PGDATABASE)
for variable in PGHOST PGHOSTADDR PGPORT PGSSLMODE PGCONNECT_TIMEOUT; do
  [[ -z "${!variable}" ]] || publisher_environment+=(-e "${variable}")
done

publisher_command() {
  docker exec "${publisher_environment[@]}" "${CONTROL_CONTAINER}" "$@"
}

publisher_revision="$(publisher_command \
  psql -X -v ON_ERROR_STOP=1 -At -c \
  'select version_num from app.alembic_version')"
[[ "${publisher_revision}" =~ ^[A-Za-z0-9_.-]{4,128}$ ]] \
  || fail "publisher Alembic revision is invalid"
publisher_tables="$(publisher_command \
  psql -X -v ON_ERROR_STOP=1 -At -c \
  "select count(*) from pg_publication_tables where pubname='${publication}'")"
[[ "${publisher_tables}" =~ ^[1-9][0-9]*$ ]] \
  || fail "publisher table inventory is empty"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
work_dir="$(mktemp -d /var/tmp/warehouse-standby-reseed.XXXXXX)"
backup_dir="${ARCHIVE_ROOT}/${timestamp}"
status_file="${STATE_ROOT}/latest.json"
schema_dump="${work_dir}/publisher-schema.sql"
local_backup="${backup_dir}/standby-before-reseed.dump"
api_containers="$(docker ps -a --format '{{.Names}}' --filter name=warehouse-os-api-)"
completed=0

cleanup() {
  rm -rf "${work_dir}"
  if [[ "${completed}" != 1 && -n "${api_containers}" ]]; then
    while IFS= read -r container; do
      [[ -z "${container}" ]] || docker start "${container}" >/dev/null 2>&1 || true
    done <<<"${api_containers}"
  fi
}
trap cleanup EXIT

install -d -m 0700 "${backup_dir}" "${STATE_ROOT}"
partial_backup="${local_backup}.partial"
docker exec "${CONTROL_CONTAINER}" sh -lc \
  'pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --format custom' \
  > "${partial_backup}"
docker exec -i "${CONTROL_CONTAINER}" pg_restore --list < "${partial_backup}" >/dev/null
chmod 0600 "${partial_backup}"
mv "${partial_backup}" "${local_backup}"
sha256sum "${local_backup}" > "${local_backup}.sha256"
chmod 0600 "${local_backup}.sha256"

publisher_command pg_dump --schema-only > "${schema_dump}"
[[ -s "${schema_dump}" ]] || fail "publisher schema dump is empty"

while IFS= read -r container; do
  [[ -z "${container}" ]] || docker stop --time 20 "${container}" >/dev/null
done <<<"${api_containers}"

control_psql -c "DROP SUBSCRIPTION ${SUBSCRIPTION}" >/dev/null
postgres_psql -c \
  "select pg_terminate_backend(pid) from pg_stat_activity where datname='${DATABASE}' and pid<>pg_backend_pid()" \
  >/dev/null
postgres_psql -c "DROP DATABASE ${DATABASE}" >/dev/null
postgres_psql -c "CREATE DATABASE ${DATABASE} OWNER warehouse_admin" >/dev/null
docker exec -i "${CONTROL_CONTAINER}" sh -lc \
  'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' \
  < "${schema_dump}" >/dev/null

docker exec -i \
  -e PUBLISHER_CONNINFO="${conninfo}" \
  -e SLOT_NAME="${slot_name}" \
  -e PUBLICATION="${publication}" \
  "${CONTROL_CONTAINER}" sh -lc \
  'psql -X -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <<'SQL'
\getenv publisher_conninfo PUBLISHER_CONNINFO
\getenv slot_name SLOT_NAME
\getenv publication PUBLICATION
CREATE SUBSCRIPTION warehouse_from_mac
  CONNECTION :'publisher_conninfo'
  PUBLICATION :"publication"
  WITH (
    copy_data=true,
    create_slot=true,
    enabled=true,
    run_as_owner=true,
    slot_name=:'slot_name',
    streaming=parallel,
    origin=none
  );
SQL

ready=0
for _ in $(seq 1 "${WAIT_SECONDS}"); do
  relation_state="$(control_psql -At -c \
    "select count(*) filter (where srsubstate::text='r'),count(*) from pg_subscription_rel where srsubid=(select oid from pg_subscription where subname='${SUBSCRIPTION}')")"
  IFS='|' read -r ready_tables total_tables <<<"${relation_state}"
  if [[ "${ready_tables}" == "${publisher_tables}" \
      && "${total_tables}" == "${publisher_tables}" ]]; then
    ready=1
    break
  fi
  sleep 1
done
[[ "${ready}" == 1 ]] \
  || fail "subscriber initial copy did not finish within ${WAIT_SECONDS}s"

subscriber_revision="$(control_psql -At -c \
  'select version_num from app.alembic_version')"
[[ "${subscriber_revision}" == "${publisher_revision}" ]] \
  || fail "Alembic revision mismatch after reseed"

publisher_counts="$(publisher_command \
  psql -X -v ON_ERROR_STOP=1 -At -F '|' -c \
  "select (select count(*) from iam.tenants),(select count(*) from digital_asset.deployments),(select count(*) from app.resource_invariants)")"
subscriber_counts="$(control_psql -At -F '|' -c \
  "select (select count(*) from iam.tenants),(select count(*) from digital_asset.deployments),(select count(*) from app.resource_invariants)")"
[[ "${subscriber_counts}" == "${publisher_counts}" ]] \
  || fail "critical table counts differ after reseed"

control_psql -c \
  "ALTER ROLE warehouse_os SET default_transaction_read_only TO true; ALTER ROLE warehouse_migrator SET default_transaction_read_only TO true" \
  >/dev/null

while IFS= read -r container; do
  [[ -z "${container}" ]] || docker start "${container}" >/dev/null
done <<<"${api_containers}"

temporary_status="${status_file}.tmp.$$"
printf '{"schema":"warehouse.standby-reseed-state.v1","status":"succeeded","completed_at":"%s","alembic_revision":"%s","tables":%s,"critical_counts":"%s","backup":"%s"}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${subscriber_revision}" \
  "${publisher_tables}" "${subscriber_counts}" "$(basename "${local_backup}")" \
  > "${temporary_status}"
chmod 0600 "${temporary_status}"
mv -f "${temporary_status}" "${status_file}"
completed=1
printf 'standby_reseed=succeeded revision=%s tables=%s backup=%s\n' \
  "${subscriber_revision}" "${publisher_tables}" "${local_backup}"
