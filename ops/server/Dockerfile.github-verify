FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 verifier

COPY ops/server/warehouse-github-verify.sh /usr/local/bin/warehouse-github-verify
RUN chmod 0755 /usr/local/bin/warehouse-github-verify

USER verifier
WORKDIR /tmp/source/backend
ENTRYPOINT ["/usr/local/bin/warehouse-github-verify"]
