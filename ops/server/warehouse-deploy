  fi
  chmod 0600 "${ENV_FILE}"
}

ensure_hosted_database() {
  local attempt state
  install_hosted_database_config
  prepare_hosted_storage
  set -a
  # shellcheck disable=SC1090
  . "${ENV_FILE}"
  set +a

  install -d -m 0700 -o 999 -g 999 "${HOSTED_DATABASE_ROOT}"
  if ! docker inspect "${HOSTED_DATABASE_CONTAINER}" >/dev/null 2>&1; then
    docker run -d \
      --name "${HOSTED_DATABASE_CONTAINER}" \
      --restart unless-stopped \
      --network warehouse-os_default \
      -e POSTGRES_DB=postgres \
      -e POSTGRES_USER=warehouse_hosted_admin \
      -e "POSTGRES_PASSWORD=${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD}" \
      -e 'POSTGRES_INITDB_ARGS=--data-checksums' \
      -v "${HOSTED_DATABASE_ROOT}:/var/lib/postgresql" \
      --health-cmd='pg_isready -U warehouse_hosted_admin -d postgres' \
      --health-interval=5s \
      --health-timeout=3s \
      --health-retries=30 \
      --health-start-period=15s \
      pgvector/pgvector:0.8.5-pg18 >/dev/null
  else
    docker start "${HOSTED_DATABASE_CONTAINER}" >/dev/null
  fi
  for ((attempt=1; attempt<=60; attempt++)); do
    state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "${HOSTED_DATABASE_CONTAINER}" 2>/dev/null || true)"
    [[ "${state}" == healthy ]] && break
    [[ "${state}" == exited || "${state}" == dead ]] && {
      docker logs --tail 120 "${HOSTED_DATABASE_CONTAINER}" >&2 || true
      fail "hosted HDD PostgreSQL failed to start"
    }
    sleep 2
  done
  [[ "${state}" == healthy ]] || fail "hosted HDD PostgreSQL did not become healthy"
  printf 'hosted_database=ready\nmedium=hdd\nroot=%s\n' "${HOSTED_DATABASE_ROOT}"
}

migrate_hosted_databases() {
  local slot api_container control_container tenant_id failed=0
  ensure_hosted_database
  slot="$(active_slot)"
  [[ -n "${slot}" ]] || fail "hosted database migration requires an active slot"
  api_container="warehouse-os-api-${slot}"
  control_container="$(docker ps --filter label=com.docker.compose.service=postgres --format '{{.Names}}' | head -n 1)"
  [[ -n "${control_container}" ]] || fail "control PostgreSQL container is unavailable"
  docker exec "${api_container}" python -c \
    'from app.services.hosted_database import configured; assert configured()' \
    || fail "active API slot is not connected to hosted PostgreSQL"
  while IFS= read -r tenant_id; do
    [[ -n "${tenant_id}" ]] || continue
    if ! docker exec "${api_container}" \
      python -m app.hosted_database_cli migrate-tenant "${tenant_id}"; then
      failed=1
    fi
  done < <(
    docker exec "${control_container}" psql \
      --username warehouse_admin --dbname warehouse_os --tuples-only --no-align \
      --command 'SELECT id FROM iam.tenants ORDER BY id'
  )
  [[ "${failed}" == 0 ]] || fail "one or more workspace databases failed HDD migration"
  log_event hosted_database_migration succeeded "$(slot_release "${slot}")" storage "${slot}"
  printf 'hosted_database_migration=succeeded\n'
}

backup_now() {
  local control_checksum hosted_snapshot
  ensure_hosted_database
  systemctl start warehouse-postgres-backup.service
  [[ "$(systemctl show warehouse-postgres-backup.service --property=Result --value)" == success ]] \
    || fail "PostgreSQL backup service did not complete successfully"

  control_checksum="$(find /opt/warehouse-os/backups -maxdepth 1 -type f \
    -name 'warehouse-os-*.dump.sha256' -mmin -15 -print | sort | tail -n 1)"
  [[ -n "${control_checksum}" ]] || fail "fresh control database backup is missing"
  (cd "$(dirname "${control_checksum}")" && sha256sum -c "$(basename "${control_checksum}")") \
    >/dev/null || fail "control database backup checksum failed"

  hosted_snapshot="$(find "${HOSTED_ARCHIVE_ROOT}/database-backups" \
    -mindepth 1 -maxdepth 1 -type d -name 'warehouse-hosted-*' \
    -mmin -15 -print | sort | tail -n 1)"
  [[ -n "${hosted_snapshot}" ]] || fail "fresh hosted database backup is missing"
  (cd "${hosted_snapshot}" && sha256sum -c SHA256SUMS) >/dev/null \
    || fail "hosted database backup checksum failed"

  log_event database_backup succeeded "$(slot_release "$(active_slot)")" backup "$(active_slot)"
  printf 'backup=succeeded\ncontrol=%s\nhosted=%s\n' \
    "${control_checksum%.sha256}" "${hosted_snapshot}"
}

