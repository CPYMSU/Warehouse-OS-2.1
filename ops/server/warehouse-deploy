    || fail "PostgreSQL backup timer is missing from the release"
  install -m 0644 \
    "${release_dir}/infra/systemd/warehouse-postgres-backup.service" \
    /etc/systemd/system/warehouse-postgres-backup.service
  install -m 0644 \
    "${release_dir}/infra/systemd/warehouse-postgres-backup.timer" \
    /etc/systemd/system/warehouse-postgres-backup.timer
  systemctl daemon-reload
  systemctl enable --now warehouse-postgres-backup.timer >/dev/null
}

