  local asset_no="$1" source_path="$2" slot api_container
  [[ "${asset_no}" =~ ^DMA-[A-Z0-9-]{8,80}$ ]] \
    || fail "invalid digital asset number"
  [[ "${source_path}" =~ ^[A-Za-z0-9_.@/+-]{1,240}$ ]] \
    || fail "invalid source path"
