start_runtime_controller() {
  local release="$1" image="$2"
  local container="warehouse-os-runtime-controller-${release}"
  local previous

  set -a
  # shellcheck disable=SC1090
  . "${ENV_FILE}"
  set +a

  # Runtime images are platform-governed profiles. Pulling them here keeps
  # customer deployment requests away from the Docker image-management API.
  docker image inspect python:3.12-slim >/dev/null 2>&1 \
    || docker pull python:3.12-slim >/dev/null
  docker image inspect node:20-alpine >/dev/null 2>&1 \
    || docker pull node:20-alpine >/dev/null
  docker rm -f "${container}" >/dev/null 2>&1 || true
  docker run -d \
    --name "${container}" \
    --restart unless-stopped \
    --label org.bonfirework.role=runtime-controller \
    --label "org.bonfirework.release=${release}" \
    --network warehouse-os_default \
    --env-file "${ENV_FILE}" \
    -e WAREHOUSE_ENVIRONMENT=production \
    -e "WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse_os:${WAREHOUSE_API_DB_PASSWORD}@postgres:5432/warehouse_os" \
    -e WAREHOUSE_ASSET_STORAGE_ROOT=/data/hdd/digital-assets \
    -e WAREHOUSE_ASSET_CODE_SSD_ROOT=/data/ssd-code/digital-assets \
    -e WAREHOUSE_ASSET_LEGACY_STORAGE_ROOT=/data/legacy-assets \
    -e WAREHOUSE_HOSTED_RUNTIME_DATA_ROOT=/data/hdd/runtime-volumes \
    -e WAREHOUSE_RUNTIME_HOST_DATA_ROOT="${HOSTED_RUNTIME_ROOT}" \
    -e WAREHOUSE_RUNTIME_CONTROLLER_ENABLED=true \
    -e WAREHOUSE_RUNTIME_DOCKER_NETWORK=warehouse-os_default \
    -e "WAREHOUSE_HOSTED_DATABASE_ADMIN_URL=postgresql+psycopg://warehouse_hosted_admin:${WAREHOUSE_HOSTED_DB_ADMIN_PASSWORD}@${HOSTED_DATABASE_CONTAINER}:5432/postgres" \
    -e "WAREHOUSE_RELEASE_ID=${release}" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "${HOSTED_ASSET_ROOT}:/data/hdd/digital-assets" \
    -v "${HOSTED_RUNTIME_ROOT}:/data/hdd/runtime-volumes" \
    -v warehouse-os_warehouse-code-ssd:/data/ssd-code/digital-assets \
    -v "${LEGACY_ASSET_VOLUME}:/data/legacy-assets:ro" \
    --read-only \
    --tmpfs /tmp:size=64m,mode=1777 \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --pids-limit 128 \
    --memory 512m \
    --cpus 0.5 \
    --health-cmd='find /tmp/runtime-controller-ready -mmin -1 -print | grep -q .' \
    --health-interval=10s \
    --health-timeout=5s \
    --health-retries=12 \
    --health-start-period=20s \
    "${image}" python -m app.runtime_controller >/dev/null
  if ! wait_health_container "${container}" 45; then
    docker logs --tail 120 "${container}" >&2 || true
    docker rm -f "${container}" >/dev/null 2>&1 || true
    return 1
  fi
  # Keep the serving controller alive until its replacement is healthy. Queue
  # leases make the brief overlap safe; only then retire older controllers.
  while IFS= read -r previous; do
    [[ -n "${previous}" && "${previous}" != "${container}" ]] || continue
    docker rm -f "${previous}" >/dev/null 2>&1 || true
  done < <(
    docker ps -a \
      --filter label=org.bonfirework.role=runtime-controller \
      --format '{{.Names}}'
  )
  docker rm -f warehouse-os-runtime-controller >/dev/null 2>&1 || true
  printf '%s\n' "${container}"
}

wait_health_container() {
  local container="$1" attempts="${2:-45}" attempt state
  for ((attempt=1; attempt<=attempts; attempt++)); do
    state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "${container}" 2>/dev/null || true)"
    [[ "${state}" == healthy ]] && return 0
    [[ "${state}" == exited || "${state}" == dead ]] && return 1
    sleep 2
  done
  return 1
}

lane_rank() {
  case "$1" in
    quick) printf '1\n' ;;
    standard) printf '2\n' ;;
    full) printf '3\n' ;;
    *) printf '0\n' ;;
  esac
}

active_browser_image() {
