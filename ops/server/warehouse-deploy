quick_guard() {
  local candidate="$1"
  [[ -L "${CURRENT}" ]] || fail "quick deploy requires an existing immutable release"
  [[ -x "${CURRENT}/ops/deploy-plan" ]] \
    || fail "quick deploy unavailable until a smart-capable release is active"
  eval "$(
    "${CURRENT}/ops/deploy-plan" \
      --root "${CURRENT}" \
      --base-manifest "${CURRENT}/.warehouse-release/files.sha256" \
      --candidate-manifest "${candidate}/.warehouse-release/files.sha256" \
      --format shell
  )"
  [[ "${PLAN_DEPLOY_REQUIRED}" == 1 ]] \
    || fail "quick deploy contains no runtime-impacting changes"
  [[ "${PLAN_MODE}" == quick ]] \
    || fail "quick deploy refused: trusted impact plan requires ${PLAN_MODE}"
}

start_slot() {
  local slot="$1" release="$2" image="$3"
  local port container manifest release_git_sha release_alembic_head
  port="$(slot_port "${slot}")"
  container="warehouse-os-api-${slot}"
  manifest="${RELEASES}/${release}/.warehouse-release/manifest.env"
