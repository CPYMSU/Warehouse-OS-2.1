#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

DEPLOY_ROOT=/opt/warehouse-os
RELEASES="${DEPLOY_ROOT}/releases"
CURRENT="${DEPLOY_ROOT}/current"
SHARED="${DEPLOY_ROOT}/shared"
STATE="${SHARED}/deploy-state"
ENV_FILE="${SHARED}/.env.production"
INCOMING=/var/lib/warehouse-deploy/incoming
LOCK_FILE=/run/lock/warehouse-deploy.lock
LOG_FILE=/var/log/warehouse-deployments.jsonl
UPSTREAM_FILE=/etc/nginx/snippets/warehouse-api-upstream.conf
DOMAIN=https://bonfirework.org
DATA_MOUNTPOINT=/mnt/warehouse-data
HOSTED_DATA_ROOT=${DATA_MOUNTPOINT}/hosted
HOSTED_ASSET_ROOT=${HOSTED_DATA_ROOT}/digital-assets
HOSTED_RUNTIME_ROOT=${HOSTED_DATA_ROOT}/runtime-volumes
HOSTED_ARCHIVE_ROOT=${HOSTED_DATA_ROOT}/archive
HOSTED_DATABASE_ROOT=${HOSTED_DATA_ROOT}/postgres-data
HOSTED_DATABASE_OBSERVER_ROOT=${HOSTED_DATA_ROOT}/database-capacity
HOSTED_DATABASE_CONTAINER=warehouse-os-hosted-postgres
LEGACY_ASSET_VOLUME=warehouse-os_warehouse-digital-assets

BLUE_PORT=18081
GREEN_PORT=18082

fail() {
  printf 'warehouse-deploy: %s\n' "$*" >&2
  exit 1
}

valid_release_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$ ]]
}

slot_port() {
  case "$1" in
    blue) printf '%s\n' "${BLUE_PORT}" ;;
    green) printf '%s\n' "${GREEN_PORT}" ;;
    *) fail "invalid slot: $1" ;;
  esac
}

other_slot() {
  case "$1" in
    blue) printf 'green\n' ;;
    green) printf 'blue\n' ;;
    *) printf 'blue\n' ;;
  esac
}

active_slot() {
  if [[ -f "${STATE}/active-slot" ]]; then
    tr -d '\r\n' < "${STATE}/active-slot"
  fi
}

configured_node_role() {
  local role
  role="$({
    set -a
    # shellcheck disable=SC1090
    . "${ENV_FILE}"
    set +a
    printf '%s\n' "${WAREHOUSE_NODE_ROLE:-standby}"
  })"
  [[ "${role}" =~ ^(primary|standby)$ ]] \
    || fail "invalid WAREHOUSE_NODE_ROLE: ${role}"
  printf '%s\n' "${role}"
}

slot_release() {
  local slot="$1"
  if [[ -f "${STATE}/slot-${slot}-release" ]]; then
    tr -d '\r\n' < "${STATE}/slot-${slot}-release"
  fi
}

log_event() {
  local action="$1" status="$2" release="${3:-}" mode="${4:-}" slot="${5:-}"
  local duration_seconds="${6:-0}"
  [[ "${duration_seconds}" =~ ^[0-9]+$ ]] || duration_seconds=0
  printf '{"time":"%s","action":"%s","status":"%s","release":"%s","mode":"%s","slot":"%s","duration_seconds":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${action}" "${status}" \
    "${release}" "${mode}" "${slot}" "${duration_seconds}" >> "${LOG_FILE}"
}

wait_health() {
  local url="$1" attempts="${2:-45}"
  local attempt
  for ((attempt=1; attempt<=attempts; attempt++)); do
    if curl --fail --silent --show-error --max-time 3 "${url}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

validate_candidate() {
  local port="$1" mode="$2" container="$3" response_file
  local base="http://127.0.0.1:${port}"
  if ! wait_health "${base}/api/health" 60; then
    printf 'candidate health check failed\n' >&2
    return 1
  fi
  if [[ "${PLAN_ADAPTIVE:-0}" != 1 || "${PLAN_API_CONTRACT:-0}" == 1 ]]; then
    response_file="$(mktemp)"
    if ! curl --fail --silent --show-error --max-time 10 \
      --output "${response_file}" "${base}/openapi.json" \
      || ! grep -Fq '"/api/auth/passkeys/login/options"' "${response_file}" \
      || ! grep -Fq '"/api/workspaces/v1/runtime"' "${response_file}" \
      || ! grep -Fq '"/api/workspaces/v1/storage/probe"' "${response_file}" \
      || ! grep -Fq '"/api/workspaces/v1/sources/upload"' "${response_file}"; then
      rm -f "${response_file}"
      printf 'candidate OpenAPI contract is incomplete\n' >&2
      return 1
    fi
    rm -f "${response_file}"
  fi
  if [[ "${PLAN_ADAPTIVE:-0}" != 1 || "${PLAN_AUTH:-0}" == 1 ]]; then
    response_file="$(mktemp)"
    if ! curl --fail --silent --show-error --max-time 10 \
      -H 'Content-Type: application/json' \
      -d '{}' "${base}/api/auth/passkeys/login/options" \
      --output "${response_file}" \
      || ! grep -Fq '"rpId":"bonfirework.org"' "${response_file}"; then
      rm -f "${response_file}"
      printf 'candidate WebAuthn RP check failed\n' >&2
      return 1
    fi
    rm -f "${response_file}"
  fi
  if ! docker exec "${container}" alembic current | grep -q '(head)'; then
    printf 'candidate Alembic revision is not at head\n' >&2
    return 1
  fi
  if [[ "${PLAN_ADAPTIVE:-0}" != 1 || "${PLAN_STORAGE:-0}" == 1 ]]; then
    if ! docker exec "${container}" python -c \
      'from app.core.config import get_settings; from app.services.object_storage import HDD_PROVIDER_KEY, SSD_PROVIDER_KEY, object_store_for_provider; settings=get_settings(); [object_store_for_provider(settings, provider).probe_writable() for provider in (HDD_PROVIDER_KEY, SSD_PROVIDER_KEY)]'; then
      printf 'candidate object storage is not writable from the API container\n' >&2
      return 1
    fi
  fi

  if [[ "${mode}" == full ]]; then
    docker restart "${container}" >/dev/null
    if ! wait_health "${base}/api/health" 60; then
      printf 'candidate restart recovery failed\n' >&2
      return 1
    fi
    if ! nginx -t >/dev/null; then
      printf 'nginx configuration check failed\n' >&2
      return 1
    fi
  fi
}

switch_upstream() {
  local port="$1"
  local temporary
  temporary="$(mktemp "${UPSTREAM_FILE}.XXXXXX")"
  printf 'proxy_pass http://127.0.0.1:%s;\n' "${port}" > "${temporary}"
  chmod 0644 "${temporary}"
  mv -f "${temporary}" "${UPSTREAM_FILE}"
  nginx -t >/dev/null
  systemctl reload nginx
}

public_smoke() {
  local response_file
  wait_health "${DOMAIN}/api/health" 20 || return 1
  if [[ "${PLAN_ADAPTIVE:-0}" != 1 || "${PLAN_FRONTEND:-0}" == 1 ]]; then
    response_file="$(mktemp)"
    if ! curl --fail --silent --show-error --max-time 15 \
      --output "${response_file}" "${DOMAIN}/"; then
      rm -f "${response_file}"
      return 1
    fi
    if ! grep -Fq 'WAREHOUSE OS 2.1' "${response_file}"; then
      rm -f "${response_file}"
      return 1
    fi
    rm -f "${response_file}"
  fi
  if [[ "${PLAN_ADAPTIVE:-0}" == 1 && "${PLAN_DOWNLOADS:-0}" == 1 ]]; then
    curl --fail --silent --show-error --max-time 15 \
      "${DOMAIN}/api/digital-assets/guide/download" >/dev/null || return 1
    curl --fail --silent --show-error --max-time 15 \
      "${DOMAIN}/api/digital-assets/cli" >/dev/null || return 1
  fi
}

standby_smoke() {
  local port="$1" response_file base
  base="http://127.0.0.1:${port}"
  wait_health "${base}/api/health" 10 || return 1
  if [[ "${PLAN_ADAPTIVE:-0}" != 1 || "${PLAN_FRONTEND:-0}" == 1 ]]; then
    response_file="$(mktemp)"
    if ! curl --fail --silent --show-error --max-time 10 \
      --output "${response_file}" "${base}/" \
      || ! grep -Fq 'WAREHOUSE OS 2.1' "${response_file}"; then
      rm -f "${response_file}"
      return 1
    fi
    rm -f "${response_file}"
  fi
  if [[ "${PLAN_ADAPTIVE:-0}" == 1 && "${PLAN_DOWNLOADS:-0}" == 1 ]]; then
    curl --fail --silent --show-error --max-time 10 \
      "${base}/api/digital-assets/guide/download" >/dev/null || return 1
    curl --fail --silent --show-error --max-time 10 \
      "${base}/api/digital-assets/cli" >/dev/null || return 1
  fi
}

install_shield_agent() {
  local release_dir="$1" attempt
  [[ -f "${release_dir}/ops/server/warehouse-shield-agent.py" ]] \
    || fail "SHIELD host agent is missing from the release"
  [[ -f "${release_dir}/infra/systemd/warehouse-shield-agent.service" ]] \
    || fail "SHIELD systemd unit is missing from the release"

  if ! command -v certbot >/dev/null 2>&1; then
    apt-get update >/dev/null
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      certbot python3-certbot-nginx >/dev/null
  fi

  install -d -m 0750 /run/warehouse-shield /opt/warehouse-os/shared/shield
  if ! grep -q '^WAREHOUSE_SHIELD_AGENT_TOKEN=' "${ENV_FILE}"; then
    printf 'WAREHOUSE_SHIELD_AGENT_TOKEN=%s\n' "$(openssl rand -hex 32)" >> "${ENV_FILE}"
  fi
  if ! grep -q '^WAREHOUSE_SHIELD_REPAIR_APPLY=' "${ENV_FILE}"; then
    printf 'WAREHOUSE_SHIELD_REPAIR_APPLY=false\n' >> "${ENV_FILE}"
  fi
  if ! grep -q '^WAREHOUSE_SHIELD_DATA_MOUNTPOINT=' "${ENV_FILE}"; then
    printf 'WAREHOUSE_SHIELD_DATA_MOUNTPOINT=/mnt/warehouse-data\n' >> "${ENV_FILE}"
  fi
  if ! grep -q '^WAREHOUSE_SHIELD_DATA_DEVICE=' "${ENV_FILE}"; then
    printf 'WAREHOUSE_SHIELD_DATA_DEVICE=/dev/vdb1\n' >> "${ENV_FILE}"
  fi
  if ! grep -q '^WAREHOUSE_SHIELD_DATA_VOLUME_REQUIRED=' "${ENV_FILE}"; then
    printf 'WAREHOUSE_SHIELD_DATA_VOLUME_REQUIRED=true\n' >> "${ENV_FILE}"
  fi
  chmod 0600 "${ENV_FILE}"
  install -m 0755 "${release_dir}/ops/server/warehouse-shield-agent.py" \
    /usr/local/sbin/warehouse-shield-agent
  install -m 0644 "${release_dir}/infra/systemd/warehouse-shield-agent.service" \
    /etc/systemd/system/warehouse-shield-agent.service
  systemctl daemon-reload
  systemctl enable warehouse-shield-agent.service >/dev/null
  systemctl restart warehouse-shield-agent.service
  for ((attempt=1; attempt<=20; attempt++)); do
    [[ -S /run/warehouse-shield/agent.sock ]] && return 0
    sleep 1
  done
  systemctl status warehouse-shield-agent.service --no-pager >&2 || true
  fail "SHIELD host agent socket did not become ready"
}

install_backup_service() {
  local release_dir="$1"
  [[ -x "${release_dir}/infra/backup/warehouse-postgres-backup.sh" ]] \
    || fail "PostgreSQL backup script is missing from the release"
  [[ -f "${release_dir}/infra/systemd/warehouse-postgres-backup.service" ]] \
    || fail "PostgreSQL backup service is missing from the release"
