  [[ -n "${release}" ]] || return 1
  image="warehouse-os-browser:${release}"
  docker image inspect "${image}" >/dev/null 2>&1 || return 1
  printf '%s\n' "${image}"
}

active_api_image() {
  local slot container
  slot="$(active_slot)"
  [[ -n "${slot}" ]] || return 1
  container="warehouse-os-api-${slot}"
  docker inspect --format '{{.Config.Image}}' "${container}" 2>/dev/null
