    *.ini|*.json|*.md|*.py|*.sql|*.toml|*.txt) ;;
    *) fail "unsupported source text type" ;;
  esac
  slot="$(active_slot)"
  api_container="warehouse-os-api-${slot}"
  docker exec "${api_container}" python -m app.hosted_database_cli \
    workspace-source-read "${asset_no}" "${source_path}"
