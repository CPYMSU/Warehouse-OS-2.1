.appointments-masthead { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.appointment-total { color: var(--swiss-accent, #E0261C); font-size: 84rpx; font-weight: 900; letter-spacing: -5rpx; line-height: .8; }
.appointments-intro { max-width: 560rpx; margin-top: 24rpx; color: #585448; font-size: 21rpx; font-weight: 700; line-height: 1.5; }

.appointment-summary { display: grid; grid-template-columns: 1.35fr 1fr 1fr; margin-bottom: 24rpx; border-top: 3rpx solid var(--swiss-ink, #141414); border-left: 3rpx solid var(--swiss-ink, #141414); }
.appointment-summary > view { display: flex; min-height: 142rpx; padding: 16rpx; justify-content: flex-end; border-right: 3rpx solid var(--swiss-ink, #141414); border-bottom: 3rpx solid var(--swiss-ink, #141414); flex-direction: column; }
.appointment-summary .summary-lead { background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); }
.summary-kicker { margin-bottom: auto; font-size: 13rpx; font-weight: 900; letter-spacing: 2rpx; }
.summary-value { font-size: 43rpx; font-weight: 900; line-height: 1; }
.summary-label { margin-top: 7rpx; font-size: 16rpx; font-weight: 900; }

.policy-card { display: grid; grid-template-columns: 90rpx 1fr; gap: 18rpx; margin-bottom: 28rpx; padding: 20rpx; border: 3rpx solid var(--swiss-ink, #141414); border-left-width: 12rpx; background: #FAF8F2; }
.policy-index { color: var(--swiss-accent, #E0261C); font-size: 15rpx; font-weight: 900; }
.policy-kicker { color: var(--swiss-accent, #E0261C); font-size: 14rpx; font-weight: 900; letter-spacing: 2rpx; }
.policy-text { margin-top: 9rpx; color: #585448; font-size: 18rpx; line-height: 1.55; }

.appointment-list { display: flex; gap: 26rpx; flex-direction: column; }
.appointment { position: relative; display: grid; grid-template-columns: 82rpx minmax(0, 1fr); padding: 0; overflow: hidden; }
.appointment::before, .appointment::after { position: absolute; z-index: 2; left: 66rpx; width: 30rpx; height: 30rpx; border: 3rpx solid var(--swiss-ink, #141414); border-radius: 50%; background: #F1EEE5; content: ""; }
.appointment::before { top: -18rpx; }
.appointment::after { bottom: -18rpx; }
.appointment-rail { display: flex; padding: 20rpx 12rpx; align-items: center; justify-content: space-between; background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); flex-direction: column; }
.appointment-index { font-size: 18rpx; font-weight: 900; }
.appointment-status { display: block; width: 42rpx; padding: 12rpx 8rpx; background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); font-size: 16rpx; font-weight: 900; line-height: 1.15; text-align: center; writing-mode: vertical-rl; }
.status-completed { background: #167A55; }
.status-cancelled, .status-no_show { background: #85806F; }
.status-pending { background: var(--swiss-accent, #E0261C); }
.appointment-body { min-width: 0; padding: 24rpx; }
.appointment-brand { display: flex; padding-bottom: 16rpx; align-items: center; gap: 12rpx; border-bottom: 2rpx dashed var(--swiss-ink, #141414); }
.appointment-brand image { width: 42rpx; height: 42rpx; }
.appointment-brand view { min-width: 0; flex: 1; }
.appointment-brand text, .appointment-brand label { display: block; }
.appointment-brand text { color: var(--swiss-accent, #E0261C); font-size: 12rpx; font-weight: 900; letter-spacing: 2rpx; }
.appointment-brand label { margin-top: 4rpx; color: #85806F; font-family: monospace; font-size: 10rpx; font-weight: 900; }
.appointment-no { margin-top: 16rpx; color: #85806F; font-size: 16rpx; letter-spacing: 1rpx; }
.appointment-service { margin-top: 26rpx; font-size: 41rpx; font-weight: 900; letter-spacing: -2rpx; line-height: 1.05; }
.appointment-time { margin-top: 12rpx; color: var(--swiss-accent, #E0261C); font-size: 29rpx; font-weight: 900; }
.appointment-data { display: grid; grid-template-columns: 1fr 1fr 1fr; margin-top: 28rpx; border-top: 3rpx solid var(--swiss-ink, #141414); }
.appointment-data view { min-width: 0; padding: 14rpx 8rpx 0 0; }
.appointment-data text { display: block; color: #85806F; font-size: 12rpx; font-weight: 900; letter-spacing: 1rpx; }
.appointment-data label { display: block; margin-top: 7rpx; overflow: hidden; font-size: 17rpx; font-weight: 900; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.incident { margin-top: 22rpx; padding: 16rpx; border-left: 9rpx solid var(--swiss-ink, #141414); background: #EAE5DA; }
.incident.merchant { border-left-color: var(--swiss-accent, #E0261C); }
.incident.consumer { border-left-color: #85806F; }
.incident-title { font-size: 20rpx; font-weight: 900; }
.incident-detail, .incident-note { margin-top: 7rpx; color: #585448; font-size: 17rpx; line-height: 1.45; }
.report-btn, .cancel-btn { width: 100%; min-height: 76rpx; margin-top: 22rpx; border: 3rpx solid var(--swiss-accent, #E0261C); border-radius: 0; background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); font-size: 20rpx; font-weight: 900; line-height: 1.2; }
.cancel-btn { background: transparent; color: var(--swiss-accent, #E0261C); }
.empty-panel { padding: 34rpx; border: 3rpx solid var(--swiss-ink, #141414); border-top-width: 12rpx; background: #FAF8F2; }
.empty-index { color: var(--swiss-accent, #E0261C); font-size: 16rpx; font-weight: 900; letter-spacing: 3rpx; }
.empty-title { margin: 28rpx 0 14rpx; font-size: 42rpx; font-weight: 900; letter-spacing: -2rpx; }
.empty-panel .muted { font-size: 21rpx; line-height: 1.5; }
.full-btn { width: 100%; margin-top: 20rpx; }
