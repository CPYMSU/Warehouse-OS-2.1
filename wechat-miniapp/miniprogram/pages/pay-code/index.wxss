.pay-scroll { width: 100%; height: 100vh; overflow-y: auto; }
.pay-page { min-height: 100%; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); text-align: center; }
.pay-page .eyebrow, .pay-page .title { text-align: left; }
.payee { margin-bottom: 24rpx; padding: 26rpx; text-align: left; }
.payee-label { color: var(--swiss-accent, #E0261C); font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }
.payee-name { margin-top: 30rpx; font-size: 38rpx; font-weight: 800; }
.payee-meta { margin-top: 10rpx; color: #85806F; font-size: 20rpx; }
.payee-balance { margin-top: 24rpx; font-size: 26rpx; font-weight: 800; }
.amount-entry { display: flex; align-items: center; margin-bottom: 28rpx; border: 4rpx solid var(--swiss-ink, #141414); background: #fff; padding: 24rpx; text-align: left; }
.amount-entry .currency { color: var(--swiss-accent, #E0261C); font-size: 40rpx; font-weight: 800; }
.amount-entry input { flex: 1; margin-left: 18rpx; font-family: ui-monospace, monospace; font-size: 32rpx; }
.code-card { padding: 44rpx 28rpx 36rpx; }
.code-brand { display: flex; align-items: center; gap: 18rpx; text-align: left; }
.brand-mark { width: 72rpx; height: 72rpx; }
.code-label { font-size: 18rpx; font-weight: 800; letter-spacing: 4rpx; }
.code-brand-note { margin-top: 6rpx; color: #85806F; font-size: 15rpx; font-weight: 800; letter-spacing: 2rpx; }
.code-security { display: flex; justify-content: space-between; margin: 44rpx 0 28rpx; border-top: 4rpx solid var(--swiss-ink, #141414); border-bottom: 4rpx solid var(--swiss-ink, #141414); padding: 18rpx 0; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.qr-frame { position: relative; width: 470rpx; height: 470rpx; margin: 0 auto; border: 18rpx solid var(--swiss-ink, #141414); background: #FAF8F2; overflow: hidden; }
.qr-canvas { width: 434rpx; height: 434rpx; pointer-events: none; }
.scan-line, .corner { pointer-events: none; }
.scan-line { position: absolute; right: 0; left: 0; top: 0; height: 4rpx; background: var(--swiss-accent, #E0261C); box-shadow: 0 0 18rpx rgba(var(--swiss-accent-rgb, 224, 38, 28),.7); animation: qr-scan 2.4s ease-in-out infinite; }
.corner { position: absolute; width: 34rpx; height: 34rpx; border-color: var(--swiss-accent, #E0261C); }
.corner-a { top: 8rpx; left: 8rpx; border-top: 6rpx solid var(--swiss-accent, #E0261C); border-left: 6rpx solid var(--swiss-accent, #E0261C); }
.corner-b { top: 8rpx; right: 8rpx; border-top: 6rpx solid var(--swiss-accent, #E0261C); border-right: 6rpx solid var(--swiss-accent, #E0261C); }
.corner-c { bottom: 8rpx; left: 8rpx; border-bottom: 6rpx solid var(--swiss-accent, #E0261C); border-left: 6rpx solid var(--swiss-accent, #E0261C); }
.corner-d { right: 8rpx; bottom: 8rpx; border-right: 6rpx solid var(--swiss-accent, #E0261C); border-bottom: 6rpx solid var(--swiss-accent, #E0261C); }
.code { margin-top: 24rpx; overflow-wrap: anywhere; color: #85806F; font-size: 25rpx; font-weight: 800; letter-spacing: 3rpx; }
.authorized { margin-top: 26rpx; font-size: 22rpx; font-weight: 800; }
.expiry { margin-top: 24rpx; color: var(--swiss-accent, #E0261C); font-size: 20rpx; }
.guide { margin-top: 32rpx; color: #85806F; font-size: 23rpx; line-height: 1.7; text-align: left; }
.refresh { width: 100%; margin-top: 32rpx; }
@keyframes qr-scan {
  0%, 100% { transform: translateY(18rpx); opacity: .2; }
  50% { transform: translateY(410rpx); opacity: 1; }
}
