.receipt-amount { color: var(--swiss-accent, #E0261C); font-size: 46rpx; font-weight: 900; }
.receipt-lines { padding: 12rpx 0; }
.receipt-line { display: flex; padding: 13rpx 0; align-items: center; justify-content: space-between; gap: 16rpx; border-bottom: 2rpx solid rgba(var(--swiss-ink-rgb, 20, 20, 20),.14); }
.receipt-line view { min-width: 0; flex: 1; }
.receipt-line view text, .receipt-line view label { display: block; }
.receipt-line view text { overflow: hidden; font-size: 18rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.receipt-line view label { margin-top: 5rpx; color: #85806F; font-size: 14rpx; }
.receipt-line > text { font-size: 19rpx; font-weight: 900; }
.receipt-foot { display: flex; padding-top: 16rpx; justify-content: space-between; gap: 14rpx; border-top: 3rpx solid var(--swiss-ink, #141414); color: #85806F; font-size: 12rpx; }
