@keyframes receiptReveal { from { opacity: 0; transform: translateY(45rpx) rotate(.8deg); } to { opacity: 1; transform: translateY(0) rotate(0); } }
@keyframes markFloat { 0%,100% { transform: translateY(0) rotate(-8deg); } 50% { transform: translateY(-10rpx) rotate(-2deg); } }

.sales-masthead { min-height: 258rpx; padding-top: 34rpx; padding-bottom: 28rpx; }
.sales-title { margin-top: 18rpx; font-size: 76rpx; }
.sales-deck { margin-top: 22rpx; }
.masthead-mark { width: 142rpx; height: 142rpx; }
.sales-stats { grid-template-columns: repeat(4, 1fr); }
.stat { min-width: 0; min-height: 116rpx; padding: 11rpx; }
