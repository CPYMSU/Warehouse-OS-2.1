.catalog-tools { display: grid; grid-template-columns: 1fr; gap: 12rpx; margin-top: 16rpx; }
.catalog-tool { width: 100%; min-height: 78rpx; margin: 0; border: 3rpx solid var(--swiss-ink, #141414); border-radius: 0; background: transparent; font-size: 20rpx; font-weight: 900; }
.catalog-tool.primary { border-color: var(--swiss-ink, #141414); background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); }
