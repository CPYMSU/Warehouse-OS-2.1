.sales-workspace-panel { animation: salesPanelReveal .24s ease-out both; }
.sales-workspace-panel .sales-section-head { margin-top: 28rpx; }

.checkout-stage-nav { display: flex; gap: 8rpx; margin-top: 24rpx; padding: 8rpx 0; align-items: stretch; border-top: 3rpx solid var(--swiss-ink, #141414); border-bottom: 3rpx solid var(--swiss-ink, #141414); }
.checkout-stage { position: relative; display: flex; width: 150rpx; min-width: 150rpx; max-width: 150rpx; min-height: 72rpx; margin: 0; padding: 9rpx 11rpx; align-items: flex-start; justify-content: space-between; overflow: hidden; border: 2rpx solid var(--swiss-ink, #141414); border-radius: 0; background: #F1EEE5; line-height: 1; text-align: left; flex-direction: column; }
.checkout-stage::after { display: none; }
.checkout-stage text { color: #85806F; font-family: monospace; font-size: 14rpx; font-weight: 900; }
.checkout-stage .checkout-stage-label { font-size: 21rpx; font-weight: 900; }
.checkout-stage.active { background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); }
.checkout-stage.active text { color: var(--swiss-on-accent, #fff); }
.checkout-stage.done::before { position: absolute; top: 11rpx; right: 11rpx; width: 10rpx; height: 10rpx; background: #167A55; content: ""; }
.checkout-stage-panel { padding-top: 25rpx; animation: salesPanelReveal .22s ease-out both; }
.stage-heading > text, .stage-heading > label, .stage-heading > view > text, .stage-heading > view > label { display: block; }
.stage-heading > text, .stage-heading > view > text { color: var(--swiss-accent, #E0261C); font-family: monospace; font-size: 13rpx; font-weight: 900; letter-spacing: 2rpx; }
.stage-heading > label, .stage-heading > view > label { margin-top: 7rpx; font-size: 29rpx; font-weight: 900; line-height: 1.14; }
.stage-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.stage-heading-row > view { min-width: 0; flex: 1; }
.stage-heading-row > button { margin: 0; padding: 0 8rpx; border: 0; border-bottom: 2rpx solid var(--swiss-ink, #141414); border-radius: 0; background: transparent; font-size: 14rpx; line-height: 42rpx; }
.stage-party { margin-top: 18rpx; padding: 14rpx 16rpx; border-left: 8rpx solid #167A55; background: #E2EEE7; }
.stage-party text, .stage-party label { display: block; }
.stage-party > text:first-child { color: #167A55; font-size: 12rpx; font-weight: 900; letter-spacing: 2rpx; }
.stage-party label { margin-top: 4rpx; font-size: 22rpx; font-weight: 900; }
.stage-party > text:last-child { margin-top: 4rpx; color: #585448; font-size: 12rpx; }
.item-strip-caption { display: flex; margin-top: 20rpx; padding-bottom: 9rpx; align-items: center; justify-content: space-between; border-bottom: 3rpx solid var(--swiss-ink, #141414); }
.item-strip-caption text { color: var(--swiss-accent, #E0261C); font-family: monospace; font-size: 12rpx; font-weight: 900; letter-spacing: 1rpx; }
.item-strip-caption label { color: #85806F; font-size: 14rpx; font-weight: 800; }
.checkout-catalog { width: 100%; margin-top: 0; border-top: 0; white-space: nowrap; }
.checkout-catalog-track { display: inline-flex; gap: 12rpx; padding: 14rpx 22rpx 4rpx 0; }
.checkout-catalog-track .sale-choice { display: flex; width: 320rpx; min-height: 184rpx; padding: 16rpx; align-items: stretch; justify-content: space-between; border: 2rpx solid var(--swiss-ink, #141414); white-space: normal; flex-direction: column; }
.checkout-catalog-track .sale-choice.chosen { padding-left: 16rpx; border: 5rpx solid var(--swiss-accent, #E0261C); }
.checkout-catalog-track .quantity-control { align-self: flex-end; margin-top: 18rpx; }
.stage-next { width: auto; min-width: 330rpx; max-width: 100%; min-height: 82rpx; margin: 24rpx 0 0 auto; padding: 0 24rpx; border: 0; border-radius: 0; background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); font-size: 23rpx; font-weight: 900; }
.stage-actions { display: grid; grid-template-columns: 1fr 2fr; gap: 10rpx; margin-top: 24rpx; }
.stage-actions .stage-next { width: 100%; min-width: 0; margin-top: 0; }
.stage-back { width: 100%; min-height: 82rpx; margin: 0; border: 2rpx solid var(--swiss-ink, #141414); border-radius: 0; background: transparent; font-size: 18rpx; font-weight: 900; }
.catalog-jump { width: 100%; margin-top: 14rpx; border: 2rpx solid var(--swiss-ink, #141414); border-radius: 0; background: transparent; font-size: 18rpx; font-weight: 900; }
.compact-cart { margin-top: 20rpx; }
.checkout-confirm-hero { display: grid; grid-template-columns: 1.35fr 1fr; margin-top: 20rpx; border-top: 4rpx solid var(--swiss-ink, #141414); border-bottom: 4rpx solid var(--swiss-ink, #141414); }
.checkout-confirm-hero > view { min-width: 0; min-height: 124rpx; padding: 15rpx; border-right: 2rpx solid var(--swiss-ink, #141414); }
.checkout-confirm-hero > view:last-child { border-right: 0; background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); text-align: right; }
.checkout-confirm-hero text, .checkout-confirm-hero label { display: block; }
.checkout-confirm-hero text { font-size: 12rpx; font-weight: 900; letter-spacing: 2rpx; }
.checkout-confirm-hero label { margin-top: 16rpx; overflow: hidden; font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.checkout-confirm-hero > view:last-child label { font-size: 34rpx; }
.checkout-confirm-hero > view > text:last-child { margin-top: 8rpx; color: #85806F; font-size: 12rpx; letter-spacing: 0; }
.confirm-cart { margin-top: 16rpx; }
.confirm-back { width: auto; min-width: 280rpx; max-width: 100%; margin: 12rpx 0 0 auto; padding: 0 20rpx; border: 2rpx solid var(--swiss-ink, #141414); border-radius: 0; background: transparent; font-size: 20rpx; font-weight: 900; }
.catalog-intro { display: flex; margin-top: 15rpx; padding: 16rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-left: 9rpx solid var(--swiss-accent, #E0261C); background: #EAE5DA; }
.catalog-intro text { color: var(--swiss-accent, #E0261C); font-family: monospace; font-size: 13rpx; font-weight: 900; letter-spacing: 2rpx; }
.catalog-intro label { max-width: 390rpx; color: #585448; font-size: 16rpx; font-weight: 800; line-height: 1.4; text-align: right; }
.receipt-intro { margin-bottom: 18rpx; }
.sales-pager { display: grid; grid-template-columns: 1fr auto 1fr; margin-top: 18rpx; align-items: center; border-top: 3rpx solid var(--swiss-ink, #141414); border-bottom: 3rpx solid var(--swiss-ink, #141414); }
.sales-pager button { min-height: 68rpx; margin: 0; border: 0; border-radius: 0; background: transparent; font-size: 17rpx; font-weight: 900; }
.sales-pager button:first-child { border-right: 2rpx solid var(--swiss-ink, #141414); }
.sales-pager button:last-child { border-left: 2rpx solid var(--swiss-ink, #141414); }
.sales-pager text { padding: 0 22rpx; color: var(--swiss-accent, #E0261C); font-size: 15rpx; font-weight: 900; }
.customer-identity { margin-top: 8rpx; padding: 4rpx 7rpx; background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); font-size: 11rpx; font-weight: 900; }
.customer-chip.selected .customer-identity { background: var(--swiss-on-accent, #fff); color: var(--swiss-accent, #E0261C); }
.customer-management-intro { display: grid; grid-template-columns: 170rpx 1fr; margin-top: 16rpx; padding: 18rpx; gap: 16rpx; border-left: 10rpx solid var(--swiss-accent, #E0261C); background: #E8E3D8; }
.customer-management-intro text { color: var(--swiss-accent, #E0261C); font-family: monospace; font-size: 13rpx; font-weight: 900; }
.customer-management-intro label { color: #585448; font-size: 17rpx; line-height: 1.5; }
.customer-management-tools { display: grid; grid-template-columns: 1fr auto; margin-top: 18rpx; align-items: stretch; gap: 10rpx; }
.customer-management-tools input { min-width: 0; height: 72rpx; padding: 0 14rpx; border: 3rpx solid var(--swiss-ink, #141414); font-size: 18rpx; }
.customer-management-tools button { min-height: 72rpx; margin: 0; padding: 0 16rpx; border: 0; border-radius: 0; background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); font-size: 17rpx; font-weight: 900; }
.customer-create-poster { display: grid; grid-template-columns: 120rpx minmax(0, 1fr); margin-top: 16rpx; border: 3rpx solid var(--swiss-ink, #141414); background: #FAF8F2; }
.customer-create-index { padding: 15rpx; background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); font-size: 25rpx; font-weight: 900; line-height: .9; writing-mode: vertical-rl; }
.customer-create-form { min-width: 0; padding: 20rpx; }
.create-rule { display: flex; margin-top: 18rpx; padding: 13rpx; align-items: flex-start; gap: 12rpx; border-left: 7rpx solid #167A55; background: #E2EEE7; }
.create-rule text { color: #167A55; font-family: monospace; font-size: 11rpx; font-weight: 900; }
.create-rule label { color: #40564A; font-size: 14rpx; line-height: 1.45; }
.managed-customer-list { margin-top: 18rpx; border-top: 4rpx solid var(--swiss-ink, #141414); }
.managed-customer { display: grid; grid-template-columns: 58rpx minmax(0, 1fr) auto; min-height: 122rpx; align-items: stretch; border-bottom: 3rpx solid var(--swiss-ink, #141414); }
.managed-customer.unclaimed { border-left: 9rpx solid var(--swiss-accent, #E0261C); }
.managed-customer-no { display: flex; padding-top: 18rpx; justify-content: center; color: var(--swiss-accent, #E0261C); font-size: 14rpx; font-weight: 900; }
.managed-customer-main { min-width: 0; padding: 17rpx 12rpx; }
.managed-customer-main text { color: #167A55; font-size: 12rpx; font-weight: 900; letter-spacing: 1rpx; }
.managed-customer.unclaimed .managed-customer-main text { color: var(--swiss-accent, #E0261C); }
.managed-customer-main label { display: block; margin-top: 6rpx; overflow: hidden; font-size: 25rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.managed-customer-main view { margin-top: 7rpx; overflow: hidden; color: #85806F; font-size: 13rpx; text-overflow: ellipsis; white-space: nowrap; }
.managed-customer-value { display: flex; padding: 17rpx 12rpx; align-items: flex-end; flex-direction: column; }
.managed-customer-value label { font-size: 20rpx; font-weight: 900; }
.managed-customer-value text { margin-top: auto; color: #85806F; font-size: 12rpx; }
.customer-management-actions { display: flex; margin-top: 18rpx; padding: 18rpx; align-items: flex-start; justify-content: space-between; gap: 16rpx; background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); }
.customer-management-actions > view:first-child { min-width: 0; }
.customer-management-actions > view:first-child text { color: var(--swiss-accent, #E0261C); font-size: 12rpx; font-weight: 900; }
.customer-management-actions > view:first-child label { display: block; margin-top: 7rpx; font-size: 25rpx; font-weight: 900; }
.customer-management-actions > view:first-child view { margin-top: 7rpx; color: #AAA492; font-size: 12rpx; }
.customer-management-actions > view:last-child { display: flex; align-items: flex-end; gap: 6rpx; flex-direction: column; }
.customer-management-actions button { min-height: 42rpx; margin: 0; padding: 0 8rpx; border: 0; border-bottom: 2rpx solid var(--swiss-accent, #E0261C); border-radius: 0; background: transparent; color: var(--swiss-on-ink, #F5F2EB); font-size: 14rpx; line-height: 42rpx; }
.management-editor { margin-top: 12rpx; }
.customer-claim-card { margin-top: 20rpx; padding: 22rpx; overflow: hidden; border: 4rpx solid var(--swiss-ink, #141414); background: #FAF8F2; }
.customer-claim-head { display: flex; align-items: flex-start; gap: 13rpx; }
.customer-claim-head image { width: 55rpx; height: 55rpx; }
.customer-claim-head > view { min-width: 0; flex: 1; }
.customer-claim-head text, .customer-claim-head label { display: block; }
.customer-claim-head text { color: var(--swiss-accent, #E0261C); font-family: monospace; font-size: 12rpx; font-weight: 900; }
.customer-claim-head label { margin-top: 5rpx; font-size: 28rpx; font-weight: 900; }
.customer-claim-head button { margin: 0; padding: 0 8rpx; border: 0; border-bottom: 2rpx solid var(--swiss-ink, #141414); border-radius: 0; background: transparent; font-size: 14rpx; line-height: 38rpx; }
.customer-claim-grid { display: grid; grid-template-columns: 1fr 260rpx; margin-top: 22rpx; align-items: stretch; gap: 18rpx; }
.customer-claim-grid > view:first-child { display: flex; padding: 18rpx; background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); flex-direction: column; }
.customer-claim-grid > view:first-child text { font-size: 13rpx; font-weight: 900; }
.customer-claim-grid > view:first-child label { margin-top: auto; font-size: 38rpx; font-weight: 900; }
.customer-claim-qr { position: relative; width: 260rpx; height: 260rpx; border: 3rpx solid var(--swiss-ink, #141414); }
.customer-claim-qr canvas { width: 260rpx; height: 260rpx; }
.customer-claim-qr view { position: absolute; left: 18rpx; right: 18rpx; top: 50%; height: 5rpx; background: var(--swiss-accent, #E0261C); opacity: .8; }
.customer-claim-note { margin-top: 18rpx; color: #585448; font-size: 17rpx; line-height: 1.55; }
.customer-claim-foot { display: flex; margin-top: 18rpx; padding-top: 12rpx; align-items: center; justify-content: space-between; gap: 12rpx; border-top: 4rpx solid var(--swiss-ink, #141414); }
.customer-claim-foot text { color: #85806F; font-size: 12rpx; }
.customer-claim-foot button { margin: 0; border: 0; border-radius: 0; background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); font-size: 15rpx; font-weight: 900; }
@keyframes salesPanelReveal { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
