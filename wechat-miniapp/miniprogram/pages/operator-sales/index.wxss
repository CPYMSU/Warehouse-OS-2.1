.editor-textarea { width: 100%; min-height: 150rpx; margin-top: 10rpx; padding: 14rpx; box-sizing: border-box; border: 2rpx solid var(--swiss-ink, #141414); font-size: 19rpx; }
.editor-status { display: flex; margin-top: 20rpx; padding: 16rpx 0; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 2rpx solid var(--swiss-ink, #141414); }
.editor-status view { flex: 1; }
.editor-status text, .editor-status label { display: block; }
.editor-status text { font-size: 18rpx; font-weight: 900; }
.editor-status label { margin-top: 6rpx; color: #85806F; font-size: 15rpx; line-height: 1.4; }
.editor-code { margin-top: 12rpx; color: #85806F; font-size: 13rpx; }
.editor-save { width: 100%; margin-top: 20rpx; border: 0; border-radius: 0; background: var(--swiss-accent, #E0261C); color: var(--swiss-on-accent, #fff); font-size: 21rpx; font-weight: 900; }
.catalog-list { margin-top: 16rpx; }
.catalog-card { display: grid; grid-template-columns: 52rpx minmax(0,1fr) auto; gap: 16rpx; padding: 20rpx 0; border-top: 3rpx solid var(--swiss-ink, #141414); }
