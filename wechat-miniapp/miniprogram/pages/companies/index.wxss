.companies-masthead { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.company-total { color: var(--swiss-accent, #E0261C); font-size: 84rpx; font-weight: 900; letter-spacing: -5rpx; line-height: .8; }
.companies-intro { max-width: 560rpx; margin-top: 24rpx; color: #585448; font-size: 21rpx; font-weight: 700; line-height: 1.5; }
.company { display: grid; grid-template-columns: 70rpx minmax(0, 1fr) 84rpx; min-height: 132rpx; align-items: stretch; border-top: 3rpx solid var(--swiss-ink, #141414); }
.company:last-of-type { border-bottom: 3rpx solid var(--swiss-ink, #141414); }
.company.selected { background: var(--swiss-ink, #141414); color: var(--swiss-on-ink, #F5F2EB); }
.company-index { display: flex; padding-top: 27rpx; justify-content: center; color: var(--swiss-accent, #E0261C); font-size: 18rpx; font-weight: 900; }
.company-main { min-width: 0; padding: 23rpx 8rpx; }
.company-name { overflow: hidden; font-size: 31rpx; font-weight: 900; letter-spacing: -1rpx; text-overflow: ellipsis; white-space: nowrap; }
.company-meta { margin-top: 9rpx; color: #85806F; font-size: 20rpx; }
.company-link { margin-top: 7rpx; color: #85806F; font-size: 16rpx; }
.company-mode { display: flex; padding: 0 10rpx; align-items: center; justify-content: center; color: var(--swiss-accent, #E0261C); font-size: 15rpx; font-weight: 900; letter-spacing: 2rpx; writing-mode: vertical-rl; }
.company-empty { padding: 30rpx 0; border-top: 3rpx solid var(--swiss-ink, #141414); border-bottom: 3rpx solid var(--swiss-ink, #141414); color: #85806F; font-family: monospace; font-size: 18rpx; }
.join-section { margin-top: 58rpx; }
.join-instruction { display: grid; grid-template-columns: 150rpx 1fr; gap: 18rpx; margin-bottom: 20rpx; padding: 18rpx; border-left: 10rpx solid var(--swiss-accent, #E0261C); background: #E8E3D8; }
.join-instruction text { color: var(--swiss-accent, #E0261C); font-size: 15rpx; font-weight: 900; }
.join-instruction label { color: #585448; font-size: 18rpx; line-height: 1.45; }
.code-input { height: 98rpx; margin-bottom: 14rpx; padding: 0 22rpx; border: 3rpx solid var(--swiss-ink, #141414); background: #FAF8F2; font-size: 27rpx; font-weight: 900; text-transform: lowercase; }
.btn { width: 100%; }
.lookup { margin-bottom: 20rpx; }
.join-preview { margin: 22rpx 0; padding: 26rpx; text-align: left; }
.preview-label { color: var(--swiss-accent, #E0261C); font-size: 16rpx; font-weight: 900; letter-spacing: 3rpx; }
.preview-name { margin-top: 34rpx; font-size: 42rpx; font-weight: 900; letter-spacing: -2rpx; }
.preview-meta, .preview-mode { margin-top: 10rpx; color: #85806F; font-size: 19rpx; }
.consent-copy, .consent-unavailable { margin-top: 24rpx; padding-top: 20rpx; border-top: 3rpx solid rgba(var(--swiss-ink-rgb, 20, 20, 20),.18); color: #585448; font-size: 20rpx; line-height: 1.65; }
.consent-version { margin-bottom: 8rpx; color: var(--swiss-accent, #E0261C); font-size: 16rpx; font-weight: 900; }
.consent-unavailable { color: var(--swiss-accent, #E0261C); }
.consent { margin: 26rpx 0; color: #585448; font-size: 20rpx; line-height: 1.55; }
.consent checkbox { transform: scale(.78); transform-origin: left center; }
.rules-link { display: inline-block; margin-top: 22rpx; padding-bottom: 6rpx; border-bottom: 2rpx solid currentColor; color: var(--swiss-accent, #E0261C); font-size: 19rpx; font-weight: 900; }
.disabled-link { color: #85806F; }
